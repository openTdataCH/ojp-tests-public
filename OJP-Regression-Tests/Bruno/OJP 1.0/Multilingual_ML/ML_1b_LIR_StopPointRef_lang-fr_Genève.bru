meta {
  name: ML_1b_LIR_StopPointRef_lang-fr_Genève
  type: http
  seq: 2
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <ServiceRequestContext>
                  <Language>fr</Language>
              </ServiceRequestContext>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPLocationInformationRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>ML_1b</MessageIdentifier>
                  <ojp:InitialInput>
                      <ojp:LocationName>Genève</ojp:LocationName>
                  </ojp:InitialInput>
                  <ojp:Restrictions>
                      <ojp:Type>stop</ojp:Type>
                      <ojp:NumberOfResults>1</ojp:NumberOfResults>
                      <ojp:IncludePtModes>true</ojp:IncludePtModes>
                  </ojp:Restrictions>
              </ojp:OJPLocationInformationRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Contains 'fr'>Genève (Genève)", function() {
      expect(res.getBody()?.toString()).to.include('<ojp:Text xml:lang="fr">Genève (Genève)</ojp:Text>');
  });
  
}

settings {
  encodeUrl: true
}
