                          <ojp:LocationName>
                              <ojp:Text>Winterthur</ojp:Text>
                          </ojp:LocationName>
                      </ojp:ViaPoint>
                  </ojp:Via>
                  <ojp:Params>
                      <ojp:NumberOfResults>5</ojp:NumberOfResults>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Body matches string StopPointRef", function () {
      expect(res.getBody()?.toString()).to.include("StopPointRef");
  });
}

