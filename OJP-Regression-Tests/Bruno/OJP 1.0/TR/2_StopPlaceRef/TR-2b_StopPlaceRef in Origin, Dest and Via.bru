                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <ojp:StopPlaceRef>ch:1:sloid:6302</ojp:StopPlaceRef>
                          <ojp:LocationName>
                              <ojp:Text>Schaffhausen</ojp:Text>
                          </ojp:LocationName>
