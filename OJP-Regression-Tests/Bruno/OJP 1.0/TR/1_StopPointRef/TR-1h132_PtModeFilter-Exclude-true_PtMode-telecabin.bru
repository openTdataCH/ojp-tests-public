                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <StopPointRef>ch:1:sloid:258</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Bern Münsterplattform</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Destination>
                  <ojp:Params>
                      <ojp:PtModeFilter>
                          <ojp:Exclude>true</ojp:Exclude>
                          <ojp:PtMode>telecabin</ojp:PtMode>
                      </ojp:PtModeFilter>
                      <ojp:NumberOfResults>3</ojp:NumberOfResults>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Body matches string not", function () {
      expect(res.getBody()?.toString()).to.not.include("telecabin");
  });
  
}

