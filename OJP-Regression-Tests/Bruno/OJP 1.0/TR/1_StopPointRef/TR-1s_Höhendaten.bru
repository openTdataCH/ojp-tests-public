meta {
  name: TR-1s_Höhendaten
  type: http
  seq: 34
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPTripRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>TR-1s</MessageIdentifier>
                  <ojp:Origin>
                      <ojp:PlaceRef>
                          <StopPointRef>8591441</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Zielweg, Zürich</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{friday_timetable_change}}T11:00:00Z</ojp:DepArrTime>
                      <ojp:IndividualTransportOptions>
                          <ojp:Mode>walk</ojp:Mode>
                          <ojp:MaxDuration>PT100M</ojp:MaxDuration>
                      </ojp:IndividualTransportOptions>
                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <StopPointRef>8503057</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Uetliberg</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Destination>
                  <ojp:Params>
                      <ojp:NumberOfResultsAfter>1</ojp:NumberOfResultsAfter>
                      <ojp:IncludeTrackSections>false</ojp:IncludeTrackSections>
                      <ojp:IncludeLegProjection>false</ojp:IncludeLegProjection>
                      <ojp:IncludeTurnDescription>false</ojp:IncludeTurnDescription>
                      <ojp:IncludeIntermediateStops>false</ojp:IncludeIntermediateStops>
                      <ojp:ItModesToCover>walk</ojp:ItModesToCover>
                      <ojp:PtModeFilter>
                          <ojp:Exclude>false</ojp:Exclude>
                          <ojp:PtMode>telecabin</ojp:PtMode>
                      </ojp:PtModeFilter>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Fussweg = 29min aufgrund Höhendaten, ohne Höhendaten wären es 24min", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:Duration>PT26M");
  
  });
  
  //mit neuer Konfig Höhendaten noch 29min
  // //pm.test("Fussweg = 29min aufgrund Höhendaten, ohne Höhendaten wären es 24min", function () {
  // //    pm.expect(pm.response.text()).to.include("<ojp:Duration>PT29M");
  //
  //});
}

settings {
  encodeUrl: true
  timeout: 0
}
