                                </ojp:TripLeg>
                            </ojp:Trip>
                        </ojp:TripResult>
                    </ojp:OJPTripDelivery>
                </siri:ServiceDelivery>
            </siri:OJPResponse>
        </siri:OJP>
      '''
    }
  }
}
