                      <ojp:IncludeTurnDescription>false</ojp:IncludeTurnDescription>
                      <ojp:IncludeIntermediateStops>false</ojp:IncludeIntermediateStops>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Body matches string", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:StartTime>" + bru.getCollectionVar('friday_timetable_change') + "T11:15:00Z</ojp:StartTime>");
  });
  
}

