post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPTripRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>TR-1f</MessageIdentifier>
                  <ojp:Origin>
                      <ojp:PlaceRef>
                          <StopPointRef>ch:1:sloid:3000</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Zürich HB</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{friday_timetable_change}}T11:00:00Z</ojp:DepArrTime>
                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <StopPointRef>ch:1:sloid:3424</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Schaffhausen</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Destination>
                  <ojp:NotVia>
                      <StopPointRef>ch:1:sloid:6000</StopPointRef>
                  </ojp:NotVia>
                  <ojp:Params>
                      <ojp:NumberOfResults>5</ojp:NumberOfResults>
                      <ojp:IncludeIntermediateStops>true</ojp:IncludeIntermediateStops>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body matches string", function () {
      expect(res.getBody()?.toString()).to.not.include("Winterthur");
  });
  
}

