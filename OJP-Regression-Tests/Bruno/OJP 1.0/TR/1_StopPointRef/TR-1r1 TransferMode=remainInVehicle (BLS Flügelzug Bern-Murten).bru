meta {
  name: TR-1r1 TransferMode=remainInVehicle (BLS Flügelzug Bern-Murten)
  type: http
  seq: 33
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPTripRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <ojp:Origin>
                      <ojp:PlaceRef>
                          <StopPointRef>8507000</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Bern (Bern)</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{friday_timetable_change}}T11:00:00Z</ojp:DepArrTime>
                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <StopPointRef>8504128</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Murten/Morat (Murten)</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Destination>
                  <ojp:Params>
                      <ojp:NumberOfResultsAfter>5</ojp:NumberOfResultsAfter>
                      <ojp:NumberOfResultsBefore>0</ojp:NumberOfResultsBefore>
                      <ojp:IncludeTrackSections>true</ojp:IncludeTrackSections>
                      <ojp:IncludeLegProjection>true</ojp:IncludeLegProjection>
                      <ojp:IncludeTurnDescription>true</ojp:IncludeTurnDescription>
                      <ojp:IncludeIntermediateStops>true</ojp:IncludeIntermediateStops>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body matches string", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:LegIntermediates>");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
