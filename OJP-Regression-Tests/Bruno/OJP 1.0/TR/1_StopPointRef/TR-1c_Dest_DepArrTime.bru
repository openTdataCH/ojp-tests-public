meta {
  name: TR-1c_Dest_DepArrTime
  type: http
  seq: 5
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPTripRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>TR-1c</MessageIdentifier>
                  <ojp:Origin>
                      <ojp:PlaceRef>
                          <StopPointRef>8507000</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Bern</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <StopPointRef>8503424</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Schaffhausen</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{friday_timetable_change}}T11:00:00Z</ojp:DepArrTime>
                  </ojp:Destination>
                  <ojp:Params>
                      <ojp:NumberOfResults>3</ojp:NumberOfResults>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Ankunftszeit vor 12 Uhr an Destination", function () {
      const expectedValue = "EndTime>" + bru.getCollectionVar('friday_timetable_change') + "T10";
  
      expect(res.getBody()?.toString()
  ).to.include(expectedValue);
  });
  
  test("Ankunftszeit nach 12 Uhr an Destination", function () {
      const expectedValue = "EndTime>" + bru.getCollectionVar('friday_timetable_change') + "T11";
  
      expect(res.getBody()?.toString()
  ).to.include(expectedValue);
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
