meta {
  name: TR-1g_NoChangeAt.StopPointRef
  type: http
  seq: 9
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPTripRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>TR-1g</MessageIdentifier>
                  <ojp:Origin>
                      <ojp:PlaceRef>
                          <StopPointRef>ch:1:sloid:3016</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Zürich Flughafen</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{friday_timetable_change}}T14:23:00Z</ojp:DepArrTime>
                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <StopPointRef>ch:1:sloid:3424</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Schaffhausen</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Destination>
                  <ojp:NoChangeAt>
                      <StopPointRef>ch:1:sloid:6000</StopPointRef>
                  </ojp:NoChangeAt>
                  <ojp:Params>
                      <ojp:NumberOfResults>1</ojp:NumberOfResults>
                      <ojp:IncludeIntermediateStops>false</ojp:IncludeIntermediateStops>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test(" Fahrt darf nicht via TransferLeg 8506000 Winterthur führen.", function () {
      expect(res.getBody()?.toString()).to.not.include("8506000");
  });
  
}

