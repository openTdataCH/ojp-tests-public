meta {
  name: TR-1e2_Via.StopPointRef_DwellTime
  type: http
  seq: 7
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPTripRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>TR-1e2</MessageIdentifier>
                  <ojp:Origin>
                      <ojp:PlaceRef>
                          <StopPointRef>ch:1:sloid:3000</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Zürich HB</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{friday_timetable_change}}T11:00:00Z</ojp:DepArrTime>
                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <StopPointRef>ch:1:sloid:3424</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Schaffhausen</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Destination>
                  <ojp:Via>
                      <ojp:ViaPoint>
                          <StopPointRef>ch:1:sloid:6000</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Winterthur</ojp:Text>
                          </ojp:LocationName>
                      </ojp:ViaPoint>
                      <!-- <ojp:DwellTime>PT2H</ojp:DwellTime> -->
                  </ojp:Via>
                  <ojp:Params>
                      <ojp:NumberOfResults>1</ojp:NumberOfResults>
                      <ojp:IncludeIntermediateStops>true</ojp:IncludeIntermediateStops>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
  
  
}

script:post-response {
  test("Body matches string", function () {
      expect(res.getBody()?.toString()).to.include("Winterthur");
  });
  
  test("Body matches string", function () {
      expect(res.getBody()?.toString()).to.include("TimetabledTime>" + bru.getCollectionVar('friday_timetable_change') + "T11");
  });
  
  // //pm.test("Body matches string", function () {
  // //    pm.expect(pm.response.text()).to.include("TimetabledTime>" + pm.collectionVariables.get('friday_timetable_change') + "T13");
  //});
  //
}

