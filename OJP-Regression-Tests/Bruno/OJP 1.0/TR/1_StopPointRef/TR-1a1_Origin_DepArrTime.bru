meta {
  name: TR-1a1_Origin_DepArrTime
  type: http
  seq: 1
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPTripRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>TR-1a1</MessageIdentifier>
                  <ojp:Origin>
                      <ojp:PlaceRef>
                          <StopPointRef>8503308</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Kloten</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{Freitag12UhrVorFahrplanwechsel}}</ojp:DepArrTime>
                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <StopPointRef>8503424</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Schaffhausen</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Destination>
                  <ojp:Params>
                      <ojp:NumberOfResults>5</ojp:NumberOfResults>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Body matches string", function () {
      expect(res.getBody()?.toString()).to.include("TimetabledTime>" + bru.getCollectionVar('DatumFreitagVorFahrplanwechsel'));
  });
  
  test("Response contains exactly 5 of </ojp:TripResult>", function () {
      var searchString = "</ojp:TripResult>";
      var responseBody = res.getBody()?.toString();
      var occurrencesCount = (responseBody.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrencesCount).to.be.at.equal(5);
  });
  
  test("Body contains Destination Text and Ref", function () {
      expect(res.getBody()?.toString()).to.include("</ojp:DestinationText>");
      expect(res.getBody()?.toString()).to.include("<ojp:DestinationStopPointRef>");
  });
  
  // Extract the XML response body
  let responseBody = res.getBody()?.toString();
  // Define the required text strings
  let requiredStrings = [
      '<siri:StopPointRef>ch:1:sloid:3308:2:4</siri:StopPointRef>',
      '<ojp:Text xml:lang="de">Kloten</ojp:Text>',
      '<ojp:Text xml:lang="de">NO_DATA</ojp:Text>',
      '<ojp:Text xml:lang="de">4</ojp:Text>',
      '<ojp:TimetabledTime>2025-12-12T10:55:00Z</ojp:TimetabledTime>',
      '<siri:StopPointRef>ch:1:sloid:3006:4:7</siri:StopPointRef>',
      '<ojp:Text xml:lang="de">Zürich Oerlikon</ojp:Text>',
      '<ojp:Text xml:lang="de">7</ojp:Text>',
      '<ojp:TimetabledTime>2025-12-12T11:02:00Z</ojp:TimetabledTime>',
      '<ojp:JourneyRef>ch:1:sjyid:100001:18745-001</ojp:JourneyRef>',
      '<siri:LineRef>ojp:91007:C</siri:LineRef>',
      '<siri:DirectionRef>R</siri:DirectionRef>',
      '<ojp:PtMode>rail</ojp:PtMode>',
      '<siri:RailSubmode>regionalRail</siri:RailSubmode>',
      '<ojp:Text xml:lang="de">Zug</ojp:Text>',
      '<ojp:Text xml:lang="de">S</ojp:Text>',
      '<ojp:Text xml:lang="de">S7</ojp:Text>',
      '<ojp:OperatorRef>ojp:11</ojp:OperatorRef>',
      '<ojp:DestinationStopPointRef>8503110</ojp:DestinationStopPointRef>',
      '<ojp:Text xml:lang="de">Rapperswil SG</ojp:Text>',
      '<ojp:Text xml:lang="de">S-Bahn</ojp:Text>',
      '<ojp:Text xml:lang="de">18745</ojp:Text>',
      '<ojp:Text xml:lang="de">Schweizerische Bundesbahnen SBB</ojp:Text>'
  
  ];
  // Check if each required string is present in the response body
  requiredStrings.forEach(function (str) {
      test(`Body contains "${str}"`, function () {
          expect(responseBody).to.include(str);
      });
  });
  
}

settings {
  encodeUrl: true
}
