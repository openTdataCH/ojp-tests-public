}

script:post-response {
  test("Body matches string StopPointRef", function () {
      expect(res.getBody()?.toString()).to.include("StopPointRef");
  });
  test("Global Test. Contains ServiceDelivery, no ErrorCondition, Statuscode 200", function () {
      expect(res.getBody()?.toString()).to.include("ServiceDelivery");
      expect(res.getBody()?.toString()).to.not.include("ErrorCondition");
      expect(res.getStatus()).to.equal(200);
  });
}

