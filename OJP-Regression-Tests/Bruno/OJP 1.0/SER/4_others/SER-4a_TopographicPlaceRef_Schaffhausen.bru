  name: SER-4a_TopographicPlaceRef_Schaffhausen
  type: http
  seq: 1
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPStopEventRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>SER-4a</MessageIdentifier>
                  <ojp:Location>
                      <ojp:PlaceRef>
                          <ojp:TopographicPlaceRef>23017939:4</ojp:TopographicPlaceRef>
                          <ojp:LocationName>
                              <ojp:Text>Schaffhausen</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{friday_timetable_change}}T11:00:00Z</ojp:DepArrTime>
                  </ojp:Location>
                  <ojp:Params>
                      <ojp:NumberOfResults>10</ojp:NumberOfResults>
                      <ojp:StopEventType>departure</ojp:StopEventType>
                      <ojp:IncludePreviousCalls>false</ojp:IncludePreviousCalls>
                      <ojp:IncludeOnwardCalls>true</ojp:IncludeOnwardCalls>
                      <ojp:IncludeOperatingDays>false</ojp:IncludeOperatingDays>
                      <ojp:IncludeRealtimeData>false</ojp:IncludeRealtimeData>
                  </ojp:Params>
              </ojp:OJPStopEventRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  
  
  test("StopPointRef 8592588 (DIDOK oder SLOID)", function() {
      const txt = res.getBody()?.toString();
      const found = txt.includes('8592588') || txt.includes('ch:1:sloid:92588');
      expect(found, 'Weder DIDOK 8592588 noch SLOID ch:1:sloid:92588 gefunden').to.be.true;
  });
}

