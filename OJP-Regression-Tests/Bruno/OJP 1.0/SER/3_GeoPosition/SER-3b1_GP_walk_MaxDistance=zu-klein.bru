meta {
  name: SER-3b1_GP_walk_MaxDistance=zu-klein
  type: http
  seq: 2
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPStopEventRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>SER-3b1</MessageIdentifier>
                  <ojp:Location>
                      <ojp:PlaceRef>
                          <ojp:GeoPosition>
                              <Longitude>8.567587</Longitude>
                              <Latitude>47.773983</Latitude>
                          </ojp:GeoPosition>
                          <ojp:LocationName>
                              <ojp:Text>Hagenturm</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{friday_timetable_change}}T11:00:00Z</ojp:DepArrTime>
                      <ojp:IndividualTransportOptions>
                          <ojp:Mode>walk</ojp:Mode>
                          <ojp:MaxDistance>700</ojp:MaxDistance>
                      </ojp:IndividualTransportOptions>
                  </ojp:Location>
                  <ojp:Params>
                      <ojp:NumberOfResults>1</ojp:NumberOfResults>
                      <ojp:StopEventType>departure</ojp:StopEventType>
                  </ojp:Params>
              </ojp:OJPStopEventRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body matches string <siri:ErrorText>TRIP_NOTRIPFOUND</siri:ErrorText>", function () {
      expect(res.getBody()?.toString()).to.include("<siri:ErrorText>STOPEVENT_NOEVENTFOUND</siri:ErrorText>");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
