meta {
  name: SER-1d2_SPoR_lineFilter_Exclude-true
  type: http
  seq: 12
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPStopEventRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>SER-1d2</MessageIdentifier>
                  <ojp:Location>
                      <ojp:PlaceRef>
                          <StopPointRef>8592588</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Schaffhausen, Wiesli</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{Freitag12UhrVorFahrplanwechsel}}</ojp:DepArrTime>
                  </ojp:Location>
                  <ojp:Params>
                      <ojp:LineFilter>
                          <ojp:Line>
                              <LineRef>ojp:92003:B</LineRef>
                          </ojp:Line>
                          <ojp:Exclude>true</ojp:Exclude>
                      </ojp:LineFilter>
                      <ojp:NumberOfResults>5</ojp:NumberOfResults>
                      <ojp:StopEventType>departure</ojp:StopEventType>
                  </ojp:Params>
              </ojp:OJPStopEventRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Linie 3 darf NICHT vorkommen", function () {
      expect(res.getBody()?.toString()).to.not.include(">3</ojp:Text>");
  });
  
}

settings {
  encodeUrl: true
}
