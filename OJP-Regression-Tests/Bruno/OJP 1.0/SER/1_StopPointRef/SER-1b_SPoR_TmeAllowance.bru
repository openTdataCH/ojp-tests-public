meta {
  name: SER-1b_SPoR_TmeAllowance
  type: http
  seq: 4
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPStopEventRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>SER-1b</MessageIdentifier>
                  <ojp:Location>
                      <ojp:PlaceRef>
                          <StopPointRef>8530813</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Zürich Kreuzplatz</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:TimeAllowance>PT2H10M</ojp:TimeAllowance>
                  </ojp:Location>
                  <ojp:Params>
                      <ojp:NumberOfResults>1</ojp:NumberOfResults>
                      <ojp:StopEventType>departure</ojp:StopEventType>
                  </ojp:Params>
              </ojp:OJPStopEventRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  // Aktuelles Datum und Uhrzeit als Zeitstempel in Millisekunden
  let currentTimeStamp = new Date().getTime();
  
  // Erzeugen der aktuellen Zeit plus 2 Stunden als Zeitstempel in Millisekunden
  let twoHoursLaterTimeStamp = currentTimeStamp + 2 * 60 * 60 * 1000;
  
  // Überprüfe, ob TimetabledTime in der Response mehr als 2 Stunden nach der aktuellen Zeit ist
  test('Überprüfe TimetabledTime ist mehr als 2 Stunden nach der aktuellen Zeit', function() {
      let responseXml = res.getBody()?.toString(); // Annahme: Die Antwort ist als XML-Text verfügbar
      let regex = new RegExp(`<ojp:TimetabledTime>(.*?)<\/ojp:TimetabledTime>`);
      let match = responseXml.match(regex);
      if (match) {
          let timetabledTimeString = match[1];
          let timetabledTime = new Date(timetabledTimeString).getTime(); // Zeitstempel der TimetabledTime
          expect(timetabledTime).to.be.above(twoHoursLaterTimeStamp);
      } else {
          expect.fail('TimetabledTime wurde nicht gefunden.');
      }
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
