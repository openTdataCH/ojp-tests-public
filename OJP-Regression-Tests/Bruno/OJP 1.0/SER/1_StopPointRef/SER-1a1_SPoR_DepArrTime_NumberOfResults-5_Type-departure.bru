meta {
  name: SER-1a1_SPoR_DepArrTime_NumberOfResults-5_Type-departure
  type: http
  seq: 1
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPStopEventRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>SER-1a1</MessageIdentifier>
                  <ojp:Location>
                      <ojp:PlaceRef>
                          <StopPointRef>8530813</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Zürich Kreuzplatz</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{Freitag12UhrVorFahrplanwechsel}}</ojp:DepArrTime>
                  </ojp:Location>
                  <ojp:Params>
                      <ojp:NumberOfResults>5</ojp:NumberOfResults>
                      <ojp:StopEventType>departure</ojp:StopEventType>
                  </ojp:Params>
              </ojp:OJPStopEventRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Variable Freitag12UhrVorFahrplanwechselStunde muss enthalten sein", function () {
      expect(res.getBody()?.toString()).to.include(bru.getCollectionVar('Freitag12UhrVorFahrplanwechselStunde'));
  });
  
  test("Response contains >= 5 of <ojp:ResultId>", function () {
      var searchString = "<ojp:ResultId>";
      var responseBody = res.getBody()?.toString();
      var occurrencesCount = (responseBody.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrencesCount).to.be.at.least(5);
  });
  
  test("Muss Angebot Verkehrshinweis enthalten Code>A__", function () {
      expect(res.getBody()?.toString()).to.include("Code>A__");
  });
  
  test("OperatingDay Ref enthalten sein", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:OperatingDayRef>" + bru.getCollectionVar('DatumFreitagVorFahrplanwechselohneT'));
  });
  
  // Extract the XML response body
  let responseBody = res.getBody()?.toString();
  // Define the required text strings
  let requiredStrings = [
      '<siri:StopPointRef>ch:1:sloid:30813::0</siri:StopPointRef>',
      '<ojp:Text xml:lang="de">Zürich, Kreuzplatz</ojp:Text>',
      '<ojp:TimetabledTime>2025-12-12T11:01:00Z</ojp:TimetabledTime>',
      '<ojp:Order>20</ojp:Order>',
      '<ojp:JourneyRef>ch:1:sjyid:100648:plan:798ba3f9-1d8b-49ff-9d3e-894c167ff529</ojp:JourneyRef>',
      '<siri:LineRef>ojp:91018:D</siri:LineRef>',
      '<siri:DirectionRef>H</siri:DirectionRef>',
      '<ojp:PtMode>tram</ojp:PtMode>',
      '<siri:TramSubmode>cityTram</siri:TramSubmode>',
      '<ojp:Text xml:lang="de">Tram</ojp:Text>',
      '<ojp:Text xml:lang="de">T</ojp:Text>',
      '<ojp:Text xml:lang="de">8</ojp:Text>',
      '<ojp:OperatorRef>ojp:3849</ojp:OperatorRef>',
      '<ojp:Text xml:lang="de">Niederflureinstieg</ojp:Text>',
      '<ojp:Code>A__NF</ojp:Code>',
      '<ojp:OriginStopPointRef>ch:1:sloid:91178::0</ojp:OriginStopPointRef>',
      '<ojp:Text xml:lang="de">Zürich, Hardturm</ojp:Text>',
      '<ojp:DestinationStopPointRef>ch:1:sloid:91233::1</ojp:DestinationStopPointRef>',
      '<ojp:Text xml:lang="de">201</ojp:Text>',
      '<ojp:Text xml:lang="de">Verkehrsbetriebe Zürich INFO+</ojp:Text>'
      
  
  ];
  // Check if each required string is present in the response body
  requiredStrings.forEach(function (str) {
      test(`Body contains "${str}"`, function () {
          expect(responseBody).to.include(str);
      });
  });
  
}

settings {
  encodeUrl: true
}
