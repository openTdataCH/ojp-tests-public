  name: SER-1a2_SPoR_no-DepArrTime-Default-current-time
  type: http
  seq: 2
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPStopEventRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>SER-1a2</MessageIdentifier>
                  <ojp:Location>
                      <ojp:PlaceRef>
                          <StopPointRef>ch:1:sloid:30813</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Zürich Kreuzplatz</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Location>
                  <ojp:Params>
                      <ojp:NumberOfResults>5</ojp:NumberOfResults>
                      <ojp:StopEventType>departure</ojp:StopEventType>
                  </ojp:Params>
              </ojp:OJPStopEventRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  // Generiere das aktuelle Datum im Format "YYYY-MM-DD"
  let currentDate = new Date().toISOString().split('T')[0];
  let formattedDate = "TimetabledTime>" + currentDate;
  
  // Überprüfe, ob das heutige Datum im Format "YYYY-MM-DD" im String "TimetabledTime>YYYY-MM-DD" vorkommt
  test('Überprüfe das heutige Datum im Format "YYYY-MM-DD"', function() {
      expect(res.getBody()?.toString()).to.include(formattedDate);
  });
  
}

