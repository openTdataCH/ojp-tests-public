                      <ojp:DepArrTime{{friday_timetable_change}}T11:00:00Z/ojp:DepArrTime>
                  </ojp:Location>
                  <ojp:Params>
                      <ojp:PtModeFilter>
                          <ojp:Exclude>false</ojp:Exclude>
                          <ojp:PtMode>bus</ojp:PtMode>
                      </ojp:PtModeFilter>
                      <ojp:NumberOfResults>10</ojp:NumberOfResults>
                      <ojp:StopEventType>departure</ojp:StopEventType>
                  </ojp:Params>
              </ojp:OJPStopEventRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body matches string not", function () {
      expect(res.getBody()?.toString()).to.not.include("<ojp:PtMode>tram</ojp:PtMode>");
  });
  
