meta {
  name: SER-1a3_SPoR_no-Params-Default-NumberOfResults-40-Type-departure
  type: http
  seq: 3
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPStopEventRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>SER-1a3</MessageIdentifier>
                  <ojp:Location>
                      <ojp:PlaceRef>
                          <StopPointRef>ch:1:sloid:30813</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Zürich Kreuzplatz</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{friday_timetable_change}}T11:00:00Z</ojp:DepArrTime>
                  </ojp:Location>
              </ojp:OJPStopEventRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Response contains >= 40 of <ojp:ThisCall>", function () {
      var searchString = "<ojp:ThisCall>";
      var responseBody = res.getBody()?.toString();
      var occurrencesCount = (responseBody.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrencesCount).to.be.at.least(40);
  });
  
  test("Body matches not ServiceArrival", function () {
      expect(res.getBody()?.toString()).to.not.include(bru.getGlobalEnvVar("<ojp:ServiceArrival>"));
  });
  
  test("Body matches <ojp:JourneyRef>", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:JourneyRef>");
  });
  
}

