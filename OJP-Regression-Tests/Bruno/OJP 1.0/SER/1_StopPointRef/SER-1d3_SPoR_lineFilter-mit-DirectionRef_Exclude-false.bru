meta {
  name: SER-1d3_SPoR_lineFilter-mit-DirectionRef_Exclude-false
  type: http
  seq: 13
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPStopEventRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>SER-1d3</MessageIdentifier>
                  <ojp:Location>
                      <ojp:PlaceRef>
                          <StopPointRef>8592588</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Schaffhausen, Wiesli</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{friday_timetable_change}}T11:00:00Z</ojp:DepArrTime>
                  </ojp:Location>
                  <ojp:Params>
                      <ojp:LineFilter>
                          <ojp:Line>
                              <LineRef>ojp:92003:B</LineRef>
                              <siri:DirectionRef>R</siri:DirectionRef>
                          </ojp:Line>
                          <ojp:Exclude>false</ojp:Exclude>
                      </ojp:LineFilter>
                      <ojp:NumberOfResults>10</ojp:NumberOfResults>
                      <ojp:StopEventType>departure</ojp:StopEventType>
                  </ojp:Params>
              </ojp:OJPStopEventRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body includes ojp:92003:B", function () {
      expect(res.getBody()?.toString()).to.include("ojp:92003:B");
  });
  
  test("Body doesn't include ojp:92007:D", function () {
      expect(res.getBody()?.toString()).to.not.include("ojp:92007:D");
  });
  
  test("Body includes DirectionRef R", function () {
      expect(res.getBody()?.toString()).to.include("<siri:DirectionRef>R</siri:DirectionRef>");
  });
  
  test("Body doesn't include DirectionRef H", function () {
      expect(res.getBody()?.toString()).to.not.include("<siri:DirectionRef>H</siri:DirectionRef>");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
