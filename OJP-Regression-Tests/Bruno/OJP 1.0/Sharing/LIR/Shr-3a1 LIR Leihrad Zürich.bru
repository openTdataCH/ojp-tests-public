meta {
  name: Shr-3a1 LIR Leihrad Zürich
  type: http
  seq: 3
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <OJP xmlns="http://www.siri.org.uk/siri" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd" version="1.0">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPLocationInformationRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>Shr-3a</MessageIdentifier>
                  <ojp:InitialInput>
                      <ojp:GeoRestriction>
                          <ojp:Circle> <!--Anfrag mittels Circle oder Rectangle-->
                              <ojp:Center> <!--Koordinate, zu welcher Objekte geliefert werden sollen-->
                                  <Longitude>8.538788</Longitude> <!--WGS84 Lon-->
                                  <Latitude>47.374773</Latitude> <!--WGS84 Lat-->
                              </ojp:Center>
                              <ojp:Radius>500</ojp:Radius>  <!--Radius in Meter um Koordinate-->
                          </ojp:Circle>
                      </ojp:GeoRestriction>
                  </ojp:InitialInput>
                  <ojp:Restrictions>
                      <ojp:Type>poi</ojp:Type>
                      <ojp:PointOfInterestFilter>
                          <ojp:PointOfInterestCategory>
                              <ojp:OsmTag>
                                  <ojp:Tag>amenity</ojp:Tag>
                                  <ojp:Value>bicycle_rental</ojp:Value>
                              </ojp:OsmTag>
                          </ojp:PointOfInterestCategory>
                      </ojp:PointOfInterestFilter>
                  </ojp:Restrictions>
              </ojp:OJPLocationInformationRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body matches string bicycle_rental", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:Value>bicycle_rental</ojp:Value>");
  });
  test("Body matches string num_docks and vehicles available", function () {
      expect(res.getBody()?.toString()).to.include("ojp:num_vehicles_available")
      expect(res.getBody()?.toString()).to.include("ojp:num_docks_available");;
  });
  
}

settings {
  encodeUrl: true
}

