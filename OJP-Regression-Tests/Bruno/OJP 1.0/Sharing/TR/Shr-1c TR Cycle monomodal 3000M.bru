meta {
  name: Shr-1c TR Cycle monomodal 3000M
  type: http
  seq: 3
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="utf-8"?>
  <OJP xmlns="http://www.siri.org.uk/siri" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd" version="1.0">
      <OJPRequest>
          <ServiceRequest>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <ojp:OJPTripRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>Shr-1c</MessageIdentifier>
                  <ojp:Origin>
                      <ojp:PlaceRef>
                          <ojp:GeoPosition>
                              <Longitude>7.445806931277815</Longitude>
                              <Latitude>46.92810152536751</Latitude>
                          </ojp:GeoPosition>
                          <ojp:LocationName>
                              <ojp:Text>46.928102,7.445807 Bern</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:IndividualTransportOptions>
                          <ojp:Mode>cycle</ojp:Mode> <!--Fahrrad am Anfang-->
                          <ojp:MaxDuration>PT3000M</ojp:MaxDuration> <!--Optional: maximale Fahrtdauer mit gewähltem Mode-->
                      </ojp:IndividualTransportOptions>
                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <ojp:GeoPosition>
                              <Longitude>7.852090</Longitude>
                              <Latitude>46.683774</Latitude>
                          </ojp:GeoPosition>
                          <ojp:LocationName>
                              <ojp:Text>46.683774,7.852090 Interlaken</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Destination>
                  <ojp:Params>
                      <ojp:NumberOfResults>1</ojp:NumberOfResults>
                      <ojp:IncludeTrackSections>true</ojp:IncludeTrackSections>
                      <ojp:IncludeLegProjection>true</ojp:IncludeLegProjection>
                      <ojp:IncludeTurnDescription>true</ojp:IncludeTurnDescription>
                      <ojp:IncludeIntermediateStops>true</ojp:IncludeIntermediateStops>
                      <ojp:ItModesToCover>cycle</ojp:ItModesToCover>		  
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body matches string cycle", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:IndividualMode>cycle</ojp:IndividualMode>");
  });
  test("Body matches string rail", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:PtMode>rail</ojp:PtMode>");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
