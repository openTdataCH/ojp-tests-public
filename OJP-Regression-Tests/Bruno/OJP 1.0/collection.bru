meta {
  name: OJP 1.0 2026 07
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

vars:pre-request {
  friday_timetable_change: 2026-12-11
  saturday_timetable_change: 2026-12-12
  new_timetable_date: 2026-12-12
}

script:pre-request {
  // Calculate the isoTimestamp variable
  const mymoment = require('moment');
  const now = mymoment().format("yyyy-MM-DDTHH:mm:ssZ");
  bru.setVar('isoTimestamp', now);
}
