meta {
  name: Shr-4c TR Carsharing am Ende
  type: http
  seq: 11
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPTripRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>Shr-4c</MessageIdentifier>
                  <ojp:Origin>
                      <ojp:PlaceRef>
                          <StopPointRef>8503000</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Zürich HB</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{Freitag12UhrVorFahrplanwechsel}}</ojp:DepArrTime>
                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <ojp:GeoPosition>
                              <Longitude>8.631417</Longitude>
                              <Latitude>46.818070</Latitude>
                          </ojp:GeoPosition>
                          <ojp:LocationName>
                              <ojp:Text>Erstfeld Talweg 46.818070,8.631417</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Destination>
                  <ojp:Params>
                      <ojp:IncludeTrackSections>true</ojp:IncludeTrackSections> <!--Immer true: Ausgabe geografische Route (TrackSection)-->
                      <ojp:IncludeLegProjection>true</ojp:IncludeLegProjection> <!--Optional: Ausgabe Koordinaten der Fahrstrecke (LinkProjection)--> 
                      <ojp:IncludeTurnDescription>true</ojp:IncludeTurnDescription> <!--Optional: Ausgabe Abbiegeanweisungen (PathGuidance)--> 
                      <ojp:IncludeIntermediateStops>true</ojp:IncludeIntermediateStops> <!--Optional: Ausgabe Zwischenhaltestellen der ÖV Route--> 
                      <ojp:Extension>
                          <ojp:Destination>
                              <ojp:Mode>car_sharing</ojp:Mode> <!--CarSharer am Ende-->
                              <ojp:MaxDuration>PT59M</ojp:MaxDuration> <!--Optional: maximale Fahrtdauer mit gewähltem Mode-->
                          </ojp:Destination>
                      </ojp:Extension>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body matches string Mobility", function () {
      expect(res.getBody()?.toString()).to.include("Mobility");
  });
  test("Body matches string self-drive-car", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:IndividualMode>self-drive-car</ojp:IndividualMode>");
  });
}

settings {
  encodeUrl: true
}
