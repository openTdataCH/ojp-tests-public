meta {
  name: Shr-1b TR Cycle am Anfang
  type: http
  seq: 2
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="utf-8"?>
  <OJP xmlns="http://www.siri.org.uk/siri" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd" version="1.0">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPTripRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>Shr-1b</MessageIdentifier>
                  <ojp:Origin>
                      <ojp:PlaceRef>
                          <StopPointRef>8590042</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Bern, Schlossmatte (Bern)</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{Freitag12UhrVorFahrplanwechsel}}</ojp:DepArrTime>
                      <ojp:IndividualTransportOptions>
                          <ojp:Mode>cycle</ojp:Mode> <!--Fahrrad am Anfang-->
                          <ojp:MaxDuration>PT30M</ojp:MaxDuration> <!--Optional: maximale Fahrtdauer mit gewähltem Mode-->
                          <ojp:MinDuration>PT2M</ojp:MinDuration> <!--Optional: minimale Fahrtdauer mit gewähltem Mode # -->
                          <ojp:MaxDistance>20000</ojp:MaxDistance> <!--Optional: maximale Fahrdistanz mit gewähltem Mode # -->
                          <ojp:MinDistance>100</ojp:MinDistance> <!--Optional: minimale Fahrdistanz mit gewähltem Mode #--> 
                      </ojp:IndividualTransportOptions>
                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <ojp:GeoPosition>
                              <Longitude>7.62535</Longitude>
                              <Latitude>46.72602</Latitude>
                          </ojp:GeoPosition>
                          <ojp:LocationName>
                              <ojp:Text>46.726020,7.625350</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Destination>
                  <ojp:Params>
                      <ojp:NumberOfResults>1</ojp:NumberOfResults> <!--Optional: Anzahl auszugebender, alternativer ÖV Verbindungen-->
                      <ojp:IncludeTrackSections>true</ojp:IncludeTrackSections> <!--Immer true: Ausgabe geografische Route (TrackSection)-->
                      <ojp:IncludeLegProjection>true</ojp:IncludeLegProjection> <!--Optional: Ausgabe Koordinaten der Fahrstrecke (LinkProjection)--> 
                      <ojp:IncludeTurnDescription>true</ojp:IncludeTurnDescription> <!--Optional: Ausgabe Abbiegeanweisungen (PathGuidance)--> 
                      <ojp:IncludeIntermediateStops>true</ojp:IncludeIntermediateStops> <!--Optional: Ausgabe Zwischenhaltestellen der ÖV Route--> 
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Body matches string cycle", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:IndividualMode>cycle</ojp:IndividualMode>");
  });
  test("Body matches string rail", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:PtMode>rail</ojp:PtMode>");
  });
  
}

settings {
  encodeUrl: true
}
