meta {
  name: Shr-3e TR Leihrad am Anfang und Ende
  type: http
  seq: 9
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPTripRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>Shr-3e</MessageIdentifier>
                  <ojp:Origin>
                      <ojp:PlaceRef>
                          <ojp:GeoPosition>
                              <Longitude>6.64625042823144</Longitude>
                              <Latitude>46.768469767810444</Latitude>
                          </ojp:GeoPosition>
                          <ojp:LocationName>
                              <ojp:Text>46.768470,6.646250</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{Freitag12UhrVorFahrplanwechsel}}</ojp:DepArrTime>
                  </ojp:Origin>
                  <ojp:Destination>
                      <ojp:PlaceRef>
                          <StopPointRef>8576858</StopPointRef>
                          <ojp:LocationName>
                              <ojp:Text>Gwatt (Thun)</ojp:Text>
                          </ojp:LocationName>
                      </ojp:PlaceRef>
                  </ojp:Destination>
                  <ojp:Params>
                      <ojp:NumberOfResults>5</ojp:NumberOfResults>
                      <!--Optional: Anzahl auszugebender, alternativer ÖV Verbindungen-->
                      <ojp:IncludeTrackSections>true</ojp:IncludeTrackSections>
                      <!--Immer true: Ausgabe geografische Route (TrackSection)-->
                      <ojp:IncludeLegProjection>true</ojp:IncludeLegProjection>
                      <!--Optional: Ausgabe Koordinaten der Fahrstrecke (LinkProjection)-->
                      <ojp:IncludeTurnDescription>true</ojp:IncludeTurnDescription>
                      <!--Optional: Ausgabe Abbiegeanweisungen (PathGuidance)-->
                      <ojp:IncludeIntermediateStops>true</ojp:IncludeIntermediateStops>
                      <!--Optional: Ausgabe Zwischenhaltestellen der ÖV Route-->
                      <ojp:Extension>
                          <ojp:Origin>
                              <ojp:Mode>bicycle_rental</ojp:Mode>
                              <ojp:MaxDuration>PT30M</ojp:MaxDuration>
                          </ojp:Origin>
                          <ojp:Destination>
                              <ojp:Mode>bicycle_rental</ojp:Mode>
                              <ojp:MaxDuration>PT30M</ojp:MaxDuration>
                          </ojp:Destination>
                      </ojp:Extension>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body matches string cycle", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:IndividualMode>cycle</ojp:IndividualMode>");
  });
  test("Body matches string rail", function () {
      expect(res.getBody()?.toString()).to.include("<ojp:PtMode>rail</ojp:PtMode>");
  });
}

settings {
  encodeUrl: true
}
