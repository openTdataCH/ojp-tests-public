meta {
  name: BehiG-TIR-1 Fahrt mit NF
  type: http
  seq: 6
}

post {
  url: {{server}}
  body: xml
  auth: inherit
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPTripInfoRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>BehiG-TIR-1</MessageIdentifier>
                  <ojp:JourneyRef>ch:1:sjyid:100648:plan:9dcb38cf-ed78-47d6-947b-0d609b74c98c</ojp:JourneyRef>
                  <ojp:OperatingDayRef>{{friday_timetable_change}}T11:00:00Z</ojp:OperatingDayRef>
              </ojp:OJPTripInfoRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body matches string", function () {
      expect(res.getBody()?.toString()).to.include(">PLATFORM_ACCESS_WITHOUT_ASSISTANCE<");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
