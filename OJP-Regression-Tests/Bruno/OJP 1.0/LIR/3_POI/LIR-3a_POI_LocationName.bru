meta {
  name: LIR-3a_POI_LocationName
  type: http
  seq: 1
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPLocationInformationRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>LIR-3a</MessageIdentifier>
                  <ojp:InitialInput>
                      <ojp:LocationName>Hai</ojp:LocationName>
                  </ojp:InitialInput>
                  <ojp:Restrictions>
                      <ojp:Type>poi</ojp:Type>
                      <ojp:NumberOfResults>10</ojp:NumberOfResults>
                  </ojp:Restrictions>
              </ojp:OJPLocationInformationRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Response contains specific POI", function() {
      expect(res.getBody()?.toString()).to.include("Hair (Worb)");
  });
  
  test("Response contains maincategory service and hairdresser", function () {
      expect(res.getBody()?.toString()).to.include("service");
      expect(res.getBody()?.toString()).to.include("hairdresser");
  });
  
  test("Response contains >= 10 of </ojp:PointOfInterest>", function () {
      var searchString = "</ojp:PointOfInterest>";
      var responseBody = res.getBody()?.toString();
      var occurrencesCount = (responseBody.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrencesCount).to.be.at.least(10);
  });
  
}

settings {
  encodeUrl: true
}

