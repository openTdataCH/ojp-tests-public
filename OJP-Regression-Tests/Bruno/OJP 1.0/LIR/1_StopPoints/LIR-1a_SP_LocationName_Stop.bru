meta {
  name: LIR-1a_SP_LocationName_Stop
  type: http
  seq: 1
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPLocationInformationRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>LIR-1a</MessageIdentifier>
                  <ojp:InitialInput>
                      <ojp:LocationName>Schaffh</ojp:LocationName>
                  </ojp:InitialInput>
                  <ojp:Restrictions>
                      <ojp:Type>stop</ojp:Type>
                      <ojp:NumberOfResults>10</ojp:NumberOfResults>
                  </ojp:Restrictions>
              </ojp:OJPLocationInformationRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:pre-request {
  console.log("Variable new_timetable_date: " + bru.getCollectionVar("new_timetable_date"));
  console.log("Variable saturday_timetable_change: " + bru.getCollectionVar("saturday_timetable_change"));
  console.log("Variable friday_timetable_change: " + bru.getCollectionVar("friday_timetable_change"));
  
}

script:post-response {
  test("Contains Schaffhausen", function() {
      expect(res.getBody()?.toString()).to.include("Schaffhausen");
  });
  
  // Extract the XML response body
  let responseBody = res.getBody()?.toString();
  // Define the required text strings
  let requiredStrings = [
      '<ojp:Text xml:lang="de">Schaffhausen</ojp:Text>',
      '<ojp:TopographicPlaceRef>23017939:4</ojp:TopographicPlaceRef>',
      '<ojp:Text xml:lang="de">Schaffhausen (Schaffhausen)</ojp:Text>',
      '<siri:Longitude>8.63276</siri:Longitude>',
      '<siri:Latitude>47.69828</siri:Latitude>',
      '<ojp:Complete>true</ojp:Complete>',
      '<ojp:Probability>0.81'
      
  ];
  // Check if each required string is present in the response body
  requiredStrings.forEach(function (str) {
      test(`Body contains "${str}"`, function () {
          expect(responseBody).to.include(str);
      });
  });
  
  
  test("Response contains specific StopPlaceRefs (DIDOK or SLOID)", function () {
      const responseText = res.getBody()?.toString();
      const stops = [
          { didok: "8503424", sloid: "ch:1:sloid:3424" }
      ];
      stops.forEach(({ didok, sloid }) => {
          const found = responseText.includes(didok) || responseText.includes(sloid);
          if (!found) console.log(`MISSING: ${didok} / ${sloid}`);
          expect(found, `StopPlaceRef fehlt: ${didok} oder ${sloid}`).to.be.true;
      });
  });
}

settings {
  encodeUrl: true
}
