meta {
  name: LIR-1c_SP_LocationName_GeoPosition
  type: http
  seq: 3
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPLocationInformationRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>LIR-1c</MessageIdentifier>
                  <ojp:InitialInput>
                      <GeoPosition>
                          <Longitude>8.55330</Longitude>
                          <Latitude>47.37609</Latitude>
                      </GeoPosition>
                  </ojp:InitialInput>
                  <ojp:Restrictions>
                      <ojp:Type>stop</ojp:Type>
                      <ojp:NumberOfResults>10</ojp:NumberOfResults>
                      <ojp:IncludePtModes>true</ojp:IncludePtModes>
                  </ojp:Restrictions>
              </ojp:OJPLocationInformationRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Contains first 4 StopPlaceRefs", function() {
      expect(res.getBody()?.toString()).to.include("8591303");
      expect(res.getBody()?.toString()).to.include("8591412");
      expect(res.getBody()?.toString()).to.include("8591220");
      expect(res.getBody()?.toString()).to.include("8591123");
  });
  
  test("Contains first 4 Stop Texts", function() {
      expect(res.getBody()?.toString()).to.include("Zürich, Platte");
      expect(res.getBody()?.toString()).to.include("Zürich, Voltastrasse");
      expect(res.getBody()?.toString()).to.include("Zürich, Kantonsschule");
      expect(res.getBody()?.toString()).to.include("Zürich, ETH/Universitätsspital");
  });
  
  test("correct coordinates", function() {
      expect(res.getBody()?.toString()).to.include("<siri:Longitude>8.552");
      expect(res.getBody()?.toString()).to.include("<siri:Latitude>47.375");
      expect(res.getBody()?.toString()).to.include("<siri:Longitude>8.552");
      expect(res.getBody()?.toString()).to.include("<siri:Latitude>47.374");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
