meta {
  name: LIR-1c_SP_LocationName_GeoPosition
  type: http
  seq: 3
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPLocationInformationRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>LIR-1c</MessageIdentifier>
                  <ojp:InitialInput>
                      <GeoPosition>
                          <Longitude>8.55330</Longitude>
                          <Latitude>47.37609</Latitude>
                      </GeoPosition>
                  </ojp:InitialInput>
                  <ojp:Restrictions>
                      <ojp:Type>stop</ojp:Type>
                      <ojp:NumberOfResults>10</ojp:NumberOfResults>
                      <ojp:IncludePtModes>true</ojp:IncludePtModes>
                  </ojp:Restrictions>
              </ojp:OJPLocationInformationRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Contains first 4 Stop Texts", function() {
      expect(res.getBody()?.toString()).to.include("Zürich, Platte");
      expect(res.getBody()?.toString()).to.include("Zürich, Voltastrasse");
      expect(res.getBody()?.toString()).to.include("Zürich, Kantonsschule");
      expect(res.getBody()?.toString()).to.include("Zürich, ETH/Universitätsspital");
  });
  
  test("correct coordinates", function() {
      expect(res.getBody()?.toString()).to.include("<siri:Longitude>8.552");
      expect(res.getBody()?.toString()).to.include("<siri:Latitude>47.375");
      expect(res.getBody()?.toString()).to.include("<siri:Longitude>8.552");
      expect(res.getBody()?.toString()).to.include("<siri:Latitude>47.374");
  });
  
  test("Response contains specific StopPlaceRefs (DIDOK or SLOID)", function () {
      const responseText = res.getBody()?.toString();
      const stops = [
          { didok: "8591303", sloid: "ch:1:sloid:91303" },
          { didok: "8591412", sloid: "ch:1:sloid:91412" },
          { didok: "8591220", sloid: "ch:1:sloid:91220" },
          { didok: "8591123", sloid: "ch:1:sloid:91123" }
      ];
      stops.forEach(({ didok, sloid }) => {
          const found = responseText.includes(didok) || responseText.includes(sloid);
          if (!found) console.log(`MISSING: ${didok} / ${sloid}`);
          expect(found, `StopPlaceRef fehlt: ${didok} oder ${sloid}`).to.be.true;
      });
  });
}

settings {
  encodeUrl: true
}

docs {
  [https://map.geo.admin.ch/?lang=en&amp;topic=ech&amp;bgLayer=ch.swisstopo.pixelkarte-farbe&amp;layers=ch.swisstopo.zeitreihen,ch.bfs.gebaeude_wohnungs_register,ch.bav.haltestellen-oev,ch.swisstopo.swisstlm3d-wanderwege,ch.astra.wanderland-sperrungen_umleitungen&amp;layers_opacity=1,1,1,0.8,0.8&amp;layers_visibility=false,false,true,false,false&amp;layers_timestamp=18641231,,,,&amp;E=2684156.74&amp;N=1247836.91&amp;zoom=10](https://map.geo.admin.ch/?lang=en&topic=ech&bgLayer=ch.swisstopo.pixelkarte-farbe&layers=ch.swisstopo.zeitreihen,ch.bfs.gebaeude_wohnungs_register,ch.bav.haltestellen-oev,ch.swisstopo.swisstlm3d-wanderwege,ch.astra.wanderland-sperrungen_umleitungen&layers_opacity=1,1,1,0.8,0.8&layers_visibility=false,false,true,false,false&layers_timestamp=18641231,,,,&E=2684156.74&N=1247836.91&zoom=10)
}

