meta {
  name: LIR-1d_SP_LocationName_GeoRestriction
  type: http
  seq: 4
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPLocationInformationRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>LIR-1d</MessageIdentifier>
                  <ojp:InitialInput>
                      <ojp:GeoRestriction>
                          <ojp:Circle>
                              <ojp:Center>
                                  <Longitude>8.55330</Longitude>
                                  <Latitude>47.37609</Latitude>
                              </ojp:Center>
                              <ojp:Radius>1000</ojp:Radius>
                          </ojp:Circle>
                      </ojp:GeoRestriction>
                  </ojp:InitialInput>
                  <ojp:Restrictions>
                      <ojp:Type>stop</ojp:Type>
                      <ojp:NumberOfResults>10</ojp:NumberOfResults>
                  </ojp:Restrictions>
              </ojp:OJPLocationInformationRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Response contains specific StopPlaceRefs", function() {
      expect(res.getBody()?.toString()).to.include("8591412");
      expect(res.getBody()?.toString()).to.include("8591303");
      expect(res.getBody()?.toString()).to.include("8591123");
      expect(res.getBody()?.toString()).to.include("8591220");
      expect(res.getBody()?.toString()).to.include("8591192");
      expect(res.getBody()?.toString()).to.include("8591230");
      expect(res.getBody()?.toString()).to.include("8503500");
      expect(res.getBody()?.toString()).to.include("8591397");
      expect(res.getBody()?.toString()).to.include("8591078");
      expect(res.getBody()?.toString()).to.include("8591287");
  
  });
  
  test("Check if XML body contains exactly 10 </ojp:StopPlaceRef> strings", function () {
      var searchString = "</ojp:StopPlaceRef>";
      var xmlResponse = res.getBody()?.toString();
      var occurrences = (xmlResponse.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrences).to.equal(10);
  });
  
}

settings {
  encodeUrl: true
}
