meta {
  name: LIR-2c_Address_GeoRestriction
  type: http
  seq: 4
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPLocationInformationRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>LIR-2c</MessageIdentifier>
                  <ojp:InitialInput>
                      <ojp:GeoRestriction>
                      <ojp:Rectangle>
                          <ojp:UpperLeft>
                              <Longitude>8.51889</Longitude>
                              <Latitude>47.36261</Latitude>
                          </ojp:UpperLeft>
                          <ojp:LowerRight>
                              <Longitude>8.52887</Longitude>
                              <Latitude>47.35774</Latitude>
                          </ojp:LowerRight>
                      </ojp:Rectangle>
                      </ojp:GeoRestriction>
                  </ojp:InitialInput>
                  <ojp:Restrictions>
                      <ojp:Type>address</ojp:Type>
                      <ojp:NumberOfResults>10</ojp:NumberOfResults>
                  </ojp:Restrictions>
              </ojp:OJPLocationInformationRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Response contains specific AdressName", function() {
      expect(res.getBody()?.toString()).to.include("Lessingstrasse");
  });
  
  test("Response contains exactly 10 /<ojp:AddressCode>", function() {
      const matches = res.getBody()?.toString().match(/<ojp:AddressCode>/g);
      expect(matches).to.have.lengthOf(10);
  });
  
}

settings {
  encodeUrl: true
}

