meta {
  name: LIR-2b_Address_GeoPosition
  type: http
  seq: 3
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPLocationInformationRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>LIR-2b</MessageIdentifier>
                  <ojp:InitialInput>
                      <ojp:GeoPosition>
                          <Longitude>8.52062</Longitude>
                          <Latitude>47.36085</Latitude>
                      </ojp:GeoPosition>
                  </ojp:InitialInput>
                  <ojp:Restrictions>
                      <ojp:Type>address</ojp:Type>
                      <ojp:NumberOfResults>10</ojp:NumberOfResults>
                  </ojp:Restrictions>
              </ojp:OJPLocationInformationRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Response contains Text Staffelstrasse 12 (Zürich)", function() {
      expect(res.getBody()?.toString()).to.include("Staffelstrasse 12 (Zürich)");
  });
  
  test("Response contains correct GeoPosition", function() {
      expect(res.getBody()?.toString()).to.include("8.52063");
      expect(res.getBody()?.toString()).to.include("47.36084");
  });
  
  
}

settings {
  encodeUrl: true
}
