meta {
  name: LIR-2a2_Address
  type: http
  seq: 2
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPLocationInformationRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>LIR-2a</MessageIdentifier>
                  <ojp:InitialInput>
                      <ojp:LocationName>Staffelstrasse 12</ojp:LocationName>
                  </ojp:InitialInput>
                  <ojp:Restrictions>
                      <ojp:Type>address</ojp:Type>
                      <ojp:NumberOfResults>10</ojp:NumberOfResults>
                  </ojp:Restrictions>
              </ojp:OJPLocationInformationRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Response Zürich", function() {
      expect(res.getBody()?.toString()
  ).to.include("Zürich, Staffelstrasse 12");
  });
  
  test("Prüfe, ob Adresse in Wettingen enthalten ist", function () {
      var responseBody = res.getBody()?.toString();
      var string1 = "Wettingen AG, Staffelstrasse 12";
      var string2 = "Wettingen, Staffelstrasse 12";
  
      // Prüft, ob String 1 ODER (||) String 2 enthalten ist
      expect(responseBody.includes(string1) || responseBody.includes(string2)).to.be.true;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
