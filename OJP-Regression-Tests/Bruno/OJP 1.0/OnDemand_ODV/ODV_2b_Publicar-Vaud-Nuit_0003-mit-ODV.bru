meta {
  name: ODV_2b_Publicar-Vaud-Nuit_0003-mit-ODV
  type: http
  seq: 2
}

post {
  url: {{server}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.siri.org.uk/siri" version="1.0" xmlns:ojp="http://www.vdv.de/ojp" xsi:schemaLocation="http://www.siri.org.uk/siri ../ojp-xsd-v1.0/OJP.xsd">
      <OJPRequest>
          <ServiceRequest>
              <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
              <RequestorRef>SKIPlusRegTest</RequestorRef>
              <ojp:OJPTripRequest>
                  <RequestTimestamp>{{isoTimestamp}}</RequestTimestamp>
                  <MessageIdentifier>ODV_2b</MessageIdentifier>
                  <ojp:Origin>
                      <ojp:PlaceRef>
                          <StopPlaceRef>8506916</StopPlaceRef>
                          <LocationName>
                              <Text>Bettens, village (Bettens)</Text>
                          </LocationName>
                      </ojp:PlaceRef>
                      <ojp:DepArrTime>{{Samstag0003UhrVorFahrplanwechsel}}</ojp:DepArrTime>
                  </ojp:Origin>
                  <Destination>
                      <PlaceRef>
                          <StopPlaceRef>8507970</StopPlaceRef>
                          <LocationName>
                              <Text>Villars-le-Terroir, poste (Villars-le-Terroir)</Text>
                          </LocationName>
                      </PlaceRef>
                  </Destination>
                  <ojp:Params>
                      <ojp:NumberOfResults>1</ojp:NumberOfResults>
                      <ojp:IncludeTrackSections>false</ojp:IncludeTrackSections>
                      <ojp:IncludeLegProjection>false</ojp:IncludeLegProjection>
                      <ojp:IncludeTurnDescription>false</ojp:IncludeTurnDescription>
                      <ojp:IncludeIntermediateStops>false</ojp:IncludeIntermediateStops>
                  </ojp:Params>
              </ojp:OJPTripRequest>
          </ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body to include LineRef>odv", function () {
      expect(res.getBody()?.toString()).to.include("LineRef>odv");
  });
  
}

settings {
  encodeUrl: true
}
