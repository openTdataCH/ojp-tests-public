meta {
  name: BehiG-TIR-1 Fahrt mit NF
  type: http
  seq: 6
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripInfoRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>BehiG</siri:MessageIdentifier>
                  <JourneyRef>{{ActiveJourneyRef}}</JourneyRef>
                  <OperatingDayRef>{{ActiveOperatingDayRef}}</OperatingDayRef>
              </OJPTripInfoRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body matches string", function () {
      expect(res.getBody()?.toString()).to.include(">PLATFORM_ACCESS_WITHOUT_ASSISTANCE<");
  });
}

settings {
  encodeUrl: true
}
