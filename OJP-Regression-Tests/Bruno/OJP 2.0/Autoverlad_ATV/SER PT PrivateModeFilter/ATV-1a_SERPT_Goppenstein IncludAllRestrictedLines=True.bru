meta {
  name: ATV-1a_SERPT_Goppenstein IncludAllRestrictedLines=True
  type: http
  seq: 1
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:ServiceRequestContext>
                  <siri:Language>de</siri:Language>
              </siri:ServiceRequestContext>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPStopEventRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>SER-1a1</siri:MessageIdentifier>
                  <Location>
                      <PlaceRef>
                          <siri:StopPointRef>8519655</siri:StopPointRef>
                          <Name>
                              <Text>Goppenstein, Autoverlad</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{Freitag12UhrVorFahrplanwechsel}}</DepArrTime>
                  </Location>
                  <Params>
                      <IncludeAllRestrictedLines>true</IncludeAllRestrictedLines>
                      <NumberOfResults>10</NumberOfResults>
                      <StopEventType>both</StopEventType>
                  </Params>
              </OJPStopEventRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Contains LineRef>atv:", function() {
      expect(res.getBody()?.toString()).to.include("LineRef>atv:");
  });
  
  test("Contains Attribute Grossraumprofil", function() {
      expect(res.getBody()?.toString()).to.include("<Code>A__GF</Code>");
      expect(res.getBody()?.toString()).to.include("Grossraumprofil");
  });
  
  
  test("Contains DestinationText Kandersteg Autoverlad", function () {
      var responseBody = res.getBody()?.toString();
      var expectedRegex = /<DestinationText>\s*<Text\s+xml:lang="de">Kandersteg Autoverlad<\/Text>\s*<\/DestinationText>/;
      expect(responseBody).to.match(expectedRegex);
  });
  
}

settings {
  encodeUrl: true
}
