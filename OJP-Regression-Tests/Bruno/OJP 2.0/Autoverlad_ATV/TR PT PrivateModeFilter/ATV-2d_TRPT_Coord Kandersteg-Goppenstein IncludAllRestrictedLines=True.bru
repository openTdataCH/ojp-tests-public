meta {
  name: ATV-2d_TRPT_Coord Kandersteg-Goppenstein IncludAllRestrictedLines=True
  type: http
  seq: 4
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>2024-03-06T09:33:08.741Z</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>2024-03-06T09:33:08.741Z</siri:RequestTimestamp>
                  <siri:MessageIdentifier>ATV</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <GeoPosition>
                              <siri:Longitude>7.670547</siri:Longitude>
                              <siri:Latitude>46.495323</siri:Latitude>
                          </GeoPosition>
                          <Name>
                              <Text>46.495323,7.670547</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <GeoPosition>
                              <siri:Longitude>7.756261</siri:Longitude>
                              <siri:Latitude>46.366158</siri:Latitude>
                          </GeoPosition>
                          <Name>
                              <Text>46.366158,7.756261</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                      <NumberOfResults>1</NumberOfResults>
                      <IncludeAllRestrictedLines>true</IncludeAllRestrictedLines>
                      <IncludeTrackSections>false</IncludeTrackSections>
                      <IncludeLegProjection>false</IncludeLegProjection>
                      <IncludeIntermediateStops>true</IncludeIntermediateStops>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Contains LineRef>atv:", function() {
      expect(res.getBody()?.toString()).to.include("LineRef>atv:");
  });
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
