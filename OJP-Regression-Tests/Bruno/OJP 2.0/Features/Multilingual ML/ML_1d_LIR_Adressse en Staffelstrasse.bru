meta {
  name: ML_1d_LIR_Adressse en Staffelstrasse
  type: http
  seq: 4
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Accept: application/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
  	<OJPRequest>
  		<siri:ServiceRequest>
  		<siri:ServiceRequestContext>
  		<siri:Language>en</siri:Language>
  		</siri:ServiceRequestContext>
  			<siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
  			<siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
  			<OJPLocationInformationRequest>
  				<siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
  				<siri:MessageIdentifier>LIR-1a</siri:MessageIdentifier>
  				<InitialInput>
  					<Name>Staffelstrasse 12 Zürich</Name>
  				</InitialInput>
  			</OJPLocationInformationRequest>
  		</siri:ServiceRequest>
  	</OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Contains Staffelstrasse 12 (Zürich)", function() {
      expect(res.getBody()?.toString()).to.include("Staffelstrasse 12 (Zürich)");
  });
  
  // Fixed the syntax for the contains Language fr test
  test("Contains Language en", function() {
      expect(res.getBody()?.toString()).to.include('<Text xml:lang="en"');
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
