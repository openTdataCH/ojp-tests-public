meta {
  name: ML-2b_TR_HstName_lang-en Geneva
  type: http
  seq: 8
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:ServiceRequestContext>
                  <siri:Language>en</siri:Language>
              </siri:ServiceRequestContext>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-1a1NOW</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <siri:StopPointRef>8501214</siri:StopPointRef>
                          <Name>
                              <Text>Ecublens VD, EPFL</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <siri:StopPointRef>8587918</siri:StopPointRef>
                          <Name>
                              <Text>Meyrin, CERN</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                      <NumberOfResults>1</NumberOfResults>
                      <IncludeIntermediateStops>false</IncludeIntermediateStops>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Contains 8500159 - Granges (de Grenchen)", function() {
      expect(res.getBody()?.toString()).to.include('<Text xml:lang="en">Geneva</Text>');
      expect(res.getBody()?.toString()).to.include(">8501008<");
  });
  
  test("Contains Tramway and Metro (Mode)", function() {
      expect(res.getBody()?.toString()).to.include('<Text xml:lang="en">Tramway</Text>');
      expect(res.getBody()?.toString()).to.include('<Text xml:lang="en">Metro</Text>');
  });
  
  test("Contains Attribute en", function() {
      expect(res.getBody()?.toString()).to.include('<Text xml:lang="en">Low-floor access</Text>');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
