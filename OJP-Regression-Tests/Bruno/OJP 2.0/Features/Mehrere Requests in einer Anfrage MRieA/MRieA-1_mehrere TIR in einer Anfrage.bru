meta {
  name: MRieA-1_mehrere TIR in einer Anfrage
  type: http
  seq: 1
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <siri:MessageIdentifier>TIR-1a</siri:MessageIdentifier>
              <OJPTripInfoRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TIR-1a</siri:MessageIdentifier>
                  <JourneyRef>ch:1:sjyid:100001:815-002</JourneyRef>
                  <OperatingDayRef>{{friday_timetable_change}}</OperatingDayRef>
              </OJPTripInfoRequest>
              <OJPTripInfoRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TIR-1b</siri:MessageIdentifier>
                  <JourneyRef>ch:1:sjyid:100648:plan:32d63ce3-b8c3-427b-a861-c591aff66c99</JourneyRef>
                  <OperatingDayRef>{{friday_timetable_change}}</OperatingDayRef>
              </OJPTripInfoRequest>
              <OJPTripInfoRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TIR-1c</siri:MessageIdentifier>
                  <JourneyRef>ch:1:sjyid:100046:11138-001</JourneyRef>
                  <OperatingDayRef>{{friday_timetable_change}}</OperatingDayRef>
              </OJPTripInfoRequest>
              <OJPTripInfoRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TIR-1d</siri:MessageIdentifier>
                  <JourneyRef>{{ActiveJourneyRef}}</JourneyRef>
                  <OperatingDayRef>{{ActiveOperatingDayRef}}</OperatingDayRef>
              </OJPTripInfoRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:pre-request {
  // Define the XML request body
  const xmlRequest = `<?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>2024-01-05T08:10:12.986Z</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPStopEventRequest>
                  <siri:RequestTimestamp>2024-01-05T08:10:12.986Z</siri:RequestTimestamp>
                  <siri:MessageIdentifier>ojp2_0</siri:MessageIdentifier>
                  <Location>
                      <PlaceRef>
                          <siri:StopPointRef>8591381</siri:StopPointRef>
                          <Name>
                              <Text>Zürich Stauffacher</Text>
                          </Name>
                      </PlaceRef>
                  </Location>
                  <Params>
                      <NumberOfResults>1</NumberOfResults>
                  </Params>
              </OJPStopEventRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>`;
  
  
  
  
  
  // Send the POST request
  await bru.sendRequest({
      url: bru.getGlobalEnvVar
  
  ('server2'),
      method: 'POST',
      headers: {
          'Authorization': `Bearer ${bru.getGlobalEnvVar
  
  ('BearerToken')}`,
          'Content-Type': 'text/xml',
      },
      data: xmlRequest,
  }, async function(error, response) {
      if (error) {
          console.error('Request error:', error);
      } else {
          // Parse the XML response
          const xmlResponse = response.data;
  
          // Use an XML parsing library like xml2js to parse the response
          const xml2js = require('xml2js');
          const parser = new xml2js.Parser({ explicitArray: false });
  
          parser.parseString(xmlResponse, function (err, result) {
              if (err) {
                  console.error('XML parsing error:', err);
              } else {
                  // Extract the ActiveJourneyRef value
                  const activeJourneyRef = findPropertyValue(result, 'JourneyRef');
                  
                  // Extract the ActiveOperatingDayRef value
                  const activeOperatingDayRef = findPropertyValue(result, 'OperatingDayRef');
  
                  // Set the ActiveJourneyRef variable
                  bru.setGlobalEnvVar
  
  
  ('ActiveJourneyRef', activeJourneyRef);
                  
                  // Set the ActiveOperatingDayRef variable
                  bru.setGlobalEnvVar
  
  
  ('ActiveOperatingDayRef', activeOperatingDayRef);
  
                  // Print to the console
                  console.log('ActiveJourneyRef:', activeJourneyRef);
                  console.log('ActiveOperatingDayRef:', activeOperatingDayRef);
              }
          });
      }
  });
  
  // Helper function to find property value in the response
  function findPropertyValue(obj, propertyName) {
      for (const key in obj) {
          if (key.includes(propertyName)) {
              return obj[key];
          } else if (typeof obj[key] === 'object') {
              const result = findPropertyValue(obj[key], propertyName);
              if (result) {
                  return result;
              }
          }
      }
      return null;
  }
  
  
}

script:post-response {
  test("Body matches string EstimatedTime", function () {
      expect(res.getBody()?.toString()).to.include("EstimatedTime");
  });
  
  test("Body matches string <OnwardCall>", function () {
      expect(res.getBody()?.toString()).to.include("<OnwardCall>");
  });
  
  test("Body matches string <Service>", function () {
      expect(res.getBody()?.toString()).to.include("<Service>");
  });
  
  test("Body matches string not TrackSection", function () {
      expect(res.getBody()?.toString()).to.not.include("TrackSection");
  });
  
  // Check Reihenfolge
  // 1. Import der xml2js-Bibliothek
  const xml2js = require('xml2js');
  
  // 2. XML-Antwort in Text umwandeln
  const responseXml = res.getBody()?.toString();
  
  // 3. XML asynchron parsen
  xml2js.parseString(responseXml, (err, result) => {
      if (err) {
          console.error("Fehler beim Parsen des XML:", err);
          test("XML-Parsing war erfolgreich", () => {
              throw new Error("XML konnte nicht geparst werden.");
          });
          return;
      }
      
      // Zugriff auf das Array der OJPTripInfoDelivery-Blöcke
      const deliveries = result.OJP.OJPResponse[0]['siri:ServiceDelivery'][0].OJPTripInfoDelivery;
      
      // Sicherstellen, dass genügend Elemente für den Test vorhanden sind
      test("Antwort enthält mindestens 3 TripInfo-Blöcke", () => {
          expect(deliveries).to.have.lengthOf.at.least(3);
      });
  
      // --- Tests für die JourneyRefs ---
  
      test("JourneyRef im ersten Block ist korrekt", () => {
          // Der Wert des JourneyRef-Tags aus dem ersten Block wird extrahiert.
          const journeyRef1 = deliveries[0].TripInfoResult[0].Service[0].JourneyRef[0];
          expect(journeyRef1).to.eql("ch:1:sjyid:100001:815-002");
      });
      
      test("JourneyRef im zweiten Block ist korrekt", () => {
          const journeyRef2 = deliveries[1].TripInfoResult[0].Service[0].JourneyRef[0];
          expect(journeyRef2).to.eql("ch:1:sjyid:100648:plan:32d63ce3-b8c3-427b-a861-c591aff66c99");
      });
      
      test("JourneyRef im dritten Block ist korrekt", () => {
          const journeyRef3 = deliveries[2].TripInfoResult[0].Service[0].JourneyRef[0];
          expect(journeyRef3).to.eql("ch:1:sjyid:100046:11138-001");
      });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
