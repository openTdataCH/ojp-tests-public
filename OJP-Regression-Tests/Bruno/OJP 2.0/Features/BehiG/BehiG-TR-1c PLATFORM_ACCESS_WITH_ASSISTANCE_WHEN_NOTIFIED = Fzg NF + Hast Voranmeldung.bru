meta {
  name: BehiG-TR-1c PLATFORM_ACCESS_WITH_ASSISTANCE_WHEN_NOTIFIED = Fzg NF + Hast Voranmeldung
  type: http
  seq: 3
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>BehiG</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <StopPlaceRef>8508885</StopPlaceRef>
                          <Name>
                              <Text>Huttwil, Stadt (Huttwil)</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <StopPlaceRef>8571575</StopPlaceRef>
                          <Name>
                              <Text>Huttwil, Bahnhof (Huttwil)</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                      <NumberOfResults>1</NumberOfResults>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Contains PLATFORM_ACCESS_WITH_ASSISTANCE_WHEN_NOTIFIED", function () {
      expect(res.getBody()?.toString()).to.include(">PLATFORM_ACCESS_WITH_ASSISTANCE_WHEN_NOTIFIED<");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
