meta {
  name: SER-1c76_ModeAndModeOfOperationFilter RailSubmode no interregionalRail
  type: http
  seq: 12
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPStopEventRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>SER-1c12</siri:MessageIdentifier>
                  <Location>
                      <PlaceRef>
                          <StopPlaceRef>8507000</StopPlaceRef>
                          <Name>
                              <Text>Bern</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Location>
                  <Params>
                      <ModeFilter>
                          <Exclude>true</Exclude>
                          <siri:RailSubmode>interregionalRail</siri:RailSubmode>
                      </ModeFilter>
                      <NumberOfResults>50</NumberOfResults>
                      <StopEventType>departure</StopEventType>
                  </Params>
              </OJPStopEventRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Darf kein interregionalRail enthalten", function () {
      expect(res.getBody()?.toString()).to.not.include("<siri:RailSubmode>interregionalRail</siri:RailSubmode>");
  });
  test("Muss local enthalten", function () {
      expect(res.getBody()?.toString()).to.include("<siri:RailSubmode>local</siri:RailSubmode>");
  });
  
  test("Muss highSpeedRail enthalten", function () {
      expect(res.getBody()?.toString()).to.include("<siri:RailSubmode>highSpeedRail</siri:RailSubmode>");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
