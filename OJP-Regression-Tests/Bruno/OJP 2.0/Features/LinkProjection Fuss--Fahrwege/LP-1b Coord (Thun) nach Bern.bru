                                                  <siri:Longitude>7.43721</siri:Longitude>
                                                  <siri:Latitude>46.94849</siri:Latitude>
                                              </Position>
                                          </LinkProjection>
                                          <Duration>PT31M</Duration>
                                          <Length>31432</Length>
                                      </TrackSection>
                                  </LegTrack>
                              </TimedLeg>
                              <EmissionCO2>
                                  <KilogramPerPersonKm>0.007</KilogramPerPersonKm>
                              </EmissionCO2>
                          </Leg>
                      </Trip>
                  </TripResult>
              </OJPTripDelivery>
          </siri:ServiceDelivery>
      </OJPResponse>
  </OJP>`;
  bru.setVar("expected_xml", mySavedXml);
}

script:post-response {
  // Vergleich BeispielResponse mit aktueller Response-----------------------
  // Es wird die Variable mySavedXml aus dem PreRequest verglichen
  // ====================================================================
  // ====================================================================
  // 1. KONFIGURATION & PARSER
  // ====================================================================
  var xml2js = require('xml2js');
  
  var parser = new xml2js.Parser({
      explicitArray: false,
      mergeAttrs: true,
      stripPrefix: false, // WICHTIG: Wir lassen die Prefixe da, behandeln sie aber im Code
      async: false
  });
  
  // ====================================================================
  // 2. HILFSFUNKTIONEN
  // ====================================================================
  
  // Hilfsfunktion: Prüft, ob ein Key ignoriert werden soll (egal ob mit "siri:" oder ohne)
  function shouldIgnore(key, ignoreList) {
      // 1. Exakter Match? (z.B. "Id")
      if (ignoreList.includes(key)) return true;
      
      // 2. Match mit Prefix? (z.B. "siri:ResponseTimestamp" endet auf ":ResponseTimestamp")
      return ignoreList.some(ignoreItem => key.endsWith(":" + ignoreItem));
  }
  
  // Entfernt dynamische Felder rekursiv (Prefix-Ignorant)
  function removeDynamicFields(obj, fieldsToRemove) {
      if (typeof obj !== 'object' || obj === null) return;
  
      if (Array.isArray(obj)) {
          obj.forEach(item => removeDynamicFields(item, fieldsToRemove));
          return;
      }
  
      Object.keys(obj).forEach(key => {
          // Neue Prüfung: Ignoriert den Prefix beim Check
          if (shouldIgnore(key, fieldsToRemove)) {
              delete obj[key];
          } else {
              removeDynamicFields(obj[key], fieldsToRemove);
          }
      });
  }
  
  // Vergleichsfunktion mit Logging
  function findAndLogDifferences(obj1, obj2, path) {
      path = path || "ROOT";
      var differencesFound = false;
  
      if (!obj1 || !obj2) {
          if (obj1 !== obj2) {
              console.warn(`❌ WERT-UNTERSCHIED bei [${path}]:`);
              console.log(`   Aktuell:  ${JSON.stringify(obj1)}`);
              console.log(`   Erwartet: ${JSON.stringify(obj2)}`);
              return true;
          }
          return false;
      }
  
      if (typeof obj1 !== typeof obj2) {
          console.warn(`❌ TYP-MISMATCH bei [${path}]:`);
          console.log(`   Aktuell (${typeof obj1}): ${JSON.stringify(obj1)}`);
          console.log(`   Erwartet (${typeof obj2}): ${JSON.stringify(obj2)}`);
          return true;
      }
  
      if (typeof obj1 !== 'object') {
          if (obj1 !== obj2) {
              console.warn(`❌ WERT-UNTERSCHIED bei [${path}]:`);
              console.log(`   Aktuell:  "${obj1}"`);
              console.log(`   Erwartet: "${obj2}"`);
              return true;
          }
          return false;
      }
  
      if (Array.isArray(obj1)) {
          if (obj1.length !== obj2.length) {
              console.warn(`❌ LÄNGEN-UNTERSCHIED bei Array [${path}]:`);
              console.log(`   Aktuell Länge: ${obj1.length}`);
              console.log(`   Erwartet Länge: ${obj2.length}`);
              differencesFound = true;
          }
          
          var maxLen = Math.max(obj1.length, obj2.length);
          for (var i = 0; i < maxLen; i++) {
              if (findAndLogDifferences(obj1[i], obj2[i], `${path}[${i}]`)) {
                  differencesFound = true;
              }
          }
          return differencesFound;
      }
  
      var keys1 = Object.keys(obj1);
      var keys2 = Object.keys(obj2);
      var allKeys = new Set([...keys1, ...keys2]);
  
      allKeys.forEach(key => {
          if (!obj2.hasOwnProperty(key)) {
              console.warn(`❌ FELD ZUSÄTZLICH in Aktuell bei [${path}]: "${key}"`);
              differencesFound = true;
          } else if (!obj1.hasOwnProperty(key)) {
              console.warn(`❌ FELD FEHLT in Aktuell bei [${path}]: "${key}"`);
              differencesFound = true;
          } else {
              if (findAndLogDifferences(obj1[key], obj2[key], `${path}.${key}`)) {
                  differencesFound = true;
              }
          }
      });
  
      return differencesFound;
  }
  
  // ====================================================================
  // 3. HAUPTLOGIK
  // ====================================================================
  
  var actualXml = res.getBody()?.toString();
  var expectedXml = bru.getCollectionVar
  ("expected_xml");
  
  if (!expectedXml) {
      console.warn("Variable 'expected_xml' nicht gefunden.");
      test("SKIP: Erwartetes XML fehlt", () => true);
  } else {
      var actualJson = null;
      var expectedJson = null;
  
      parser.parseString(actualXml, (err, res) => { if(!err) actualJson = res; });
      parser.parseString(expectedXml, (err, res) => { if(!err) expectedJson = res; });
  
      if (actualJson && expectedJson) {
          
          // -----------------------------------------------------------
          // 🛠️ IGNORE LISTE (Namen ohne Prefix angeben)
          // Das Skript entfernt automatisch "siri:ResponseTimestamp" etc.
          // -----------------------------------------------------------
          var ignoreList = [
              "ResponseTimestamp",      
              "Id",                     
              "ProducerRef",           
              "ResponseMessageIdentifier",
              "Reference",
              "RequestMessageRef"       
          ];
  
          // Bereinigen (Entfernt die Felder aus beiden Objekten)
          removeDynamicFields(actualJson, ignoreList);
          removeDynamicFields(expectedJson, ignoreList);
  
          console.log("================ VERGLEICH START ================");
          var hasDiffs = findAndLogDifferences(actualJson, expectedJson, "BODY");
  
          if (!hasDiffs) {
              console.log("✅ Keine Unterschiede gefunden.");
          } else {
              console.log("⚠️ Unterschiede gefunden (siehe oben).");
          }
          console.log("================ VERGLEICH ENDE =================");
  
          test("XML Struktur und Inhalt sind identisch", function () {
              expect(hasDiffs).to.be.false;
          });
  
      } else {
          test("XML Parsing Fehler", () => expect.fail("Konnte XML nicht parsen"));
      }
  }
  
  // Visuallierung der Antowrt auf Karte----------------------------------------------
  // 🟥🟥🟥 1. SETUP & CONFIGURATION 
  var xml2js = require('xml2js');
  
  var parser = new xml2js.Parser({
      explicitArray: false,
      mergeAttrs: true,
      stripPrefix: true, 
      async: false       
  });
  
  // 🟦🟦🟦 2. HILFSFUNKTIONEN 🟦🟦🟦
  function toArray(val) {
      if (!val) return [];
      return Array.isArray(val) ? val : [val];
  }
  
  function getText(val) {
      if (!val) return "";
      if (typeof val === 'string') return val;
      if (val._) return val._;
      if (val['#text']) return val['#text'];
      return "";
  }
  
  function findDeepKey(obj, keyToFind) {
      var found = [];
      function search(node) {
          if (!node || typeof node !== 'object') return;
          if (node[keyToFind]) {
              var res = node[keyToFind];
              Array.isArray(res) ? found.push(...res) : found.push(res);
          }
          for (var k in node) {
              if (Object.prototype.hasOwnProperty.call(node, k) && typeof node[k] === 'object') {
                  search(node[k]);
              }
          }
      }
      search(obj);
      return found;
  }
  
  function extractAllCoordsInLeg(legNode) {
      var coords = [];
      function traverse(node) {
          if (!node || typeof node !== 'object') return;
  
          var lat = node.Latitude || node['siri:Latitude'];
          var lon = node.Longitude || node['siri:Longitude'];
  
          if (lat && lon) {
              coords.push([parseFloat(lat), parseFloat(lon)]);
              return; 
          }
          if (node.Position) {
              var posArray = toArray(node.Position);
              posArray.forEach(p => traverse(p));
              return;
          }
          for (var k in node) {
              if (typeof node[k] === 'object') traverse(node[k]);
          }
      }
      traverse(legNode);
      return coords;
  }
  
  // 🔥 Hilfsfunktion: Priorisiert detaillierte Pfade vor Luftlinien
  function getBestCoordsForLeg(legNode) {
      if (legNode.PathGuidance) return extractAllCoordsInLeg(legNode.PathGuidance);
      if (legNode.LegTrack) return extractAllCoordsInLeg(legNode.LegTrack);
      return extractAllCoordsInLeg(legNode);
  }
  
  // 🟩🟩🟩 3. HAUPTLOGIK 🟩🟩🟩
  parser.parseString(res.getBody()?.toString(), function (err, result) {
      if (err) { console.error("XML Error", err); return; }
  
      var mapSegments = [];
      var mapMarkers = [];
  
      var tripResults = findDeepKey(result, 'TripResult');
      console.log("Anzahl Trips:", tripResults.length);
  
      tripResults.forEach((tripRes, idx) => {
          if (!tripRes.Trip || !tripRes.Trip.Leg) return;
  
          var legs = toArray(tripRes.Trip.Leg);
  
          legs.forEach(leg => {
              var segment = {
                  coords: [],
                  mode: "unknown",
                  label: "Abschnitt",
                  color: "#999",
                  dashed: false
              };
  
              // --- A: TIMED LEG ---
              if (leg.TimedLeg) {
                  var tl = leg.TimedLeg;
                  if (tl.Service && tl.Service.Mode && tl.Service.Mode.PtMode) {
                      segment.mode = getText(tl.Service.Mode.PtMode);
                      var line = getText(tl.Service.PublishedServiceName?.Text);
                      segment.label = segment.mode + " " + line;
                  }
                  
                  if (segment.mode === 'rail') segment.color = '#FF5252'; 
                  else if (segment.mode === 'tram') segment.color = '#FFD740'; 
                  else if (segment.mode === 'bus') segment.color = '#FFAB40'; 
                  else segment.color = '#448AFF'; 
  
                  segment.coords = getBestCoordsForLeg(tl);
  
                  if(tl.LegBoard && tl.LegBoard.StopPointName) {
                      var name = getText(tl.LegBoard.StopPointName.Text);
                      if(segment.coords.length > 0) {
                          mapMarkers.push({lat: segment.coords[0][0], lon: segment.coords[0][1], name: name});
                      }
                  }
              } 
              // --- B: TRANSFER LEG ---
              else if (leg.TransferLeg) {
                  var tr = leg.TransferLeg;
                  segment.mode = "walk";
                  segment.label = "Fussweg (Transfer)";
                  segment.color = "#ccc";
                  segment.dashed = true;
                  segment.coords = getBestCoordsForLeg(tr);
              }
              // --- C: CONTINUOUS LEG ---
              else if (leg.ContinuousLeg) {
                  var cl = leg.ContinuousLeg;
                  segment.mode = "walk"; 
                  if (cl.Service && cl.Service.PersonalMode) {
                      segment.mode = getText(cl.Service.PersonalMode);
                  }
                  segment.label = "Fussweg (" + segment.mode + ")";
                  segment.color = "#ccc"; 
                  segment.dashed = true;
                  segment.coords = getBestCoordsForLeg(cl);
  
                  if (cl.LegStart && cl.LegStart.Name) {
                       let n = getText(cl.LegStart.Name.Text);
                       if(segment.coords.length > 0 && n && !n.includes(',')) {
                           mapMarkers.push({lat: segment.coords[0][0], lon: segment.coords[0][1], name: n});
                       }
                  }
              }
  
              if (segment.coords.length > 0) {
                  mapSegments.push(segment);
              }
          });
      });
  
      // 🟨🟨🟨 4. INTERAKTIVE VISUALISIERUNG 🟨🟨🟨
      var template = `
      <!DOCTYPE html>
      <html>
      <head>
          <meta charset="utf-8" />
          <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
          <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
          <style>
              body { margin: 0; font-family: 'Helvetica Neue', Arial, sans-serif; background: #222; }
              #map { height: 100vh; width: 100%; }
              .info {
                  position: absolute; bottom: 20px; left: 20px; z-index: 1000;
                  background: rgba(30, 30, 30, 0.9); color: #eee;
                  padding: 12px; border-radius: 8px; border: 1px solid #444;
                  box-shadow: 0 0 15px rgba(0,0,0,0.5); font-size: 13px;
                  backdrop-filter: blur(5px);
              }
              /* Styling für klickbare Legende */
              .item { 
                  margin-bottom: 6px; 
                  display: flex; 
                  align-items: center; 
                  cursor: pointer; 
                  padding: 3px 6px;
                  border-radius: 4px;
                  transition: background 0.2s;
              }
              .item:hover {
                  background: rgba(255,255,255,0.1);
              }
              .line { display: inline-block; width: 25px; height: 3px; margin-right: 8px; border-radius: 2px;}
              .reset-link {
                  float: right; 
                  color: #448AFF; 
                  cursor: pointer; 
                  font-size: 11px; 
                  text-decoration: underline;
                  margin-left: 10px;
              }
              .reset-link:hover { color: #82B1FF; }
              .leaflet-popup-content-wrapper, .leaflet-popup-tip { background: #333; color: #fff; }
          </style>
      </head>
      <body>
          <div id="map"></div>
          <div class="info" id="legend">Loading...</div>
  
          <script>
              var segments = ${JSON.stringify(mapSegments)};
              var markers = ${JSON.stringify(mapMarkers)};
  
              var map = L.map('map');
  
              L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                  attribution: '&copy; OpenStreetMap, &copy; CartoDB',
                  subdomains: 'abcd', maxZoom: 20
              }).addTo(map);
  
              var allBounds = [];
              var usedModes = new Set();
              var segmentLayers = []; // Speichert Referenzen zu den Linien für Spätere Manipulation
  
              // --- SEGMENTE ZEICHNEN ---
              segments.forEach(seg => {
                  usedModes.add(JSON.stringify({m: seg.mode, c: seg.color, d: seg.dashed}));
                  
                  var poly = L.polyline(seg.coords, {
                      color: seg.color,
                      weight: seg.dashed ? 3 : 5,
                      opacity: 0.9,
                      dashArray: seg.dashed ? '5, 10' : null,
                      lineCap: 'round',
                      lineJoin: 'round'
                  }).addTo(map);
                  
                  poly.bindTooltip(seg.label, { sticky: true, direction: 'top' });
                  
                  // Wir speichern das Layer Objekt + den Modus für Filterung
                  segmentLayers.push({layer: poly, mode: seg.mode});
                  
                  seg.coords.forEach(p => allBounds.push(p));
              });
  
              // --- MARKER ZEICHNEN ---
              markers.forEach(m => {
                  L.circleMarker([m.lat, m.lon], {
                      radius: 4, color: '#fff', fillColor: '#000', fillOpacity: 1, weight: 2
                  }).bindPopup('<b>' + m.name + '</b>').addTo(map);
              });
  
              // --- LEGENDE BAUEN ---
              function buildLegend() {
                  var html = '<strong>Route</strong> <span class="reset-link" onclick="resetMap()"> (Alles)</span><br><div style="height:5px"></div>';
                  if(segments.length === 0) html += "Keine Daten";
                  
                  Array.from(usedModes).forEach(s => {
                      var o = JSON.parse(s);
                      var style = 'background:' + o.c;
                      if(o.d) style += '; background:none; border-bottom: 2px dashed ' + o.c + '; height:0px; margin-top:2px;';
                      
                      // ONCLICK EVENT HINZUFÜGEN
                      html += '<div class="item" onclick="filterMap(\\'' + o.m + '\\')" title="Zoom auf ' + o.m + '">';
                      html += '<span class="line" style="' + style + '"></span> ' + o.m + '</div>';
                  });
                  document.getElementById('legend').innerHTML = html;
              }
              buildLegend();
  
              // --- INTERAKTIVE FUNKTIONEN ---
  
              // 1. Zoom auf alles
              window.resetMap = function() {
                  if (allBounds.length > 0) {
                      map.fitBounds(allBounds, { padding: [50, 50] });
                  } else {
                      map.setView([46.948, 7.447], 13);
                  }
              };
  
              // 2. Filter / Zoom auf spezifischen Modus
              window.filterMap = function(modeToFilter) {
                  var specificBounds = [];
  
                  // Durch alle Segmente gehen
                  segments.forEach(seg => {
                      if (seg.mode === modeToFilter) {
                          seg.coords.forEach(p => specificBounds.push(p));
                      }
                  });
  
                  if (specificBounds.length > 0) {
                      map.fitBounds(specificBounds, { padding: [50, 50] });
                  }
              };
  
              // Initial Zoom
              resetMap();
  
          </script>
      </body>
      </html>
      `;
  //     pm.visualizer.set(template);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
