meta {
  name: SER-1g1_SPoR_arrival_IncludePreviousCalls-true
  type: http
  seq: 19
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPStopEventRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>SER-1g1</siri:MessageIdentifier>
                  <Location>
                      <PlaceRef>
                          <siri:StopPointRef>8530813</siri:StopPointRef>
                          <Name>
                              <Text>Zürich Kreuzplatz</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{Freitag12UhrVorFahrplanwechsel}}</DepArrTime>
                  </Location>
                  <Params>
                      <NumberOfResults>1</NumberOfResults>
                      <StopEventType>arrival</StopEventType>
                      <IncludePreviousCalls>true</IncludePreviousCalls>
                      <IncludeOnwardCalls>false</IncludeOnwardCalls>
                      <IncludeOperatingDays>false</IncludeOperatingDays>
                      <IncludeRealtimeData>false</IncludeRealtimeData>
                  </Params>
              </OJPStopEventRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Body contains ", function () {
      expect(res.getBody()?.toString()).to.include("<PreviousCall>");
  });
  
  test("Body contains not <OnwardCall>", function () {
      expect(res.getBody()?.toString()).to.not.include("<OnwardCall>");
  });
  
  test("Body contains not Römerhof (weil nachfolgende Haltestelle)", function () {
      expect(res.getBody()?.toString()).to.not.include("Römerhof");
  });
  
  test("Response contains >=2 of Zürich, Hardturm, auch als erster OnwardCall", function () {
      var searchString = "Zürich, Hardturm";
      var responseBody = res.getBody()?.toString();
      var occurrencesCount = (responseBody.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrencesCount).to.be.at.least(2);
  });
}

settings {
  encodeUrl: true
}
