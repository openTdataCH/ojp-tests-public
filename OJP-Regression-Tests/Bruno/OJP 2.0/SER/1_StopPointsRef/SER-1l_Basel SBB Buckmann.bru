script:post-response {
  test("ID darf nicht 0000 sein", function () {
      expect(res.getBody()?.toString()).to.not.include("<Id>00000000-0000-0000-0000-000000000000</Id>");
  });
  
  test("Muss Order für letzten Halt enthalten", function () {
      expect(res.getBody()?.toString()).to.include("<Order>19</Order>");
  });
}

