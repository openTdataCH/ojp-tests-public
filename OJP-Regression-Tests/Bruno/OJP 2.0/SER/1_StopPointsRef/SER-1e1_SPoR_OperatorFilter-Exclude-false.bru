meta {
  name: SER-1e1_SPoR_OperatorFilter-Exclude-false
  type: http
  seq: 15
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPStopEventRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>SER-1e1</siri:MessageIdentifier>
                  <Location>
                      <PlaceRef>
                          <siri:StopPointRef>8503481</siri:StopPointRef>
                          <Name>
                              <Text>Neuhausen, Kreuzstrasse</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Location>
                  <Params>
                      <OperatorFilter>
                          <Exclude>false</Exclude>
                          <OperatorRef>ojp:836</OperatorRef>
                      </OperatorFilter>
                      <NumberOfResults>10</NumberOfResults>
                      <StopEventType>departure</StopEventType>
                  </Params>
              </OJPStopEventRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Body matches string not", function () {
      expect(res.getBody()?.toString()).to.not.include("<OperatorRef>ojp:846</OperatorRef>");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
