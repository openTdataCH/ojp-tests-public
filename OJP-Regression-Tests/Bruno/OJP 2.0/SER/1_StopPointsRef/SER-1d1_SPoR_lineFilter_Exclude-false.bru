meta {
  name: SER-1d1_SPoR_lineFilter_Exclude-false
  type: http
  seq: 11
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPStopEventRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>SER-1d1</siri:MessageIdentifier>
                  <Location>
                      <PlaceRef>
                          <siri:StopPointRef>8573458</siri:StopPointRef>
                          <Name>
                              <Text>Schaffhausen, Schützenhaus</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Location>
                  <Params>
                      <LineFilter>
                          <Line>
                              <siri:LineRef>ojp:92003:B</siri:LineRef>
                          </Line>
                          <Exclude>false</Exclude>
                      </LineFilter>
                      <NumberOfResults>20</NumberOfResults>
                      <StopEventType>departure</StopEventType>
                  </Params>
              </OJPStopEventRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Linie ojp:92003:B muss vorkommen", function () {
      expect(res.getBody()?.toString()).to.include("ojp:92003:B");
  });
  
  test("Linie ojp:92004:B darf nicht vorkommen", function () {
      expect(res.getBody()?.toString()).to.not.include("ojp:92004:B");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
