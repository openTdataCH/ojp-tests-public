meta {
  name: SER-1d3_SPoR_lineFilter-mit-DirectionRef_Exclude-false
  type: http
  seq: 13
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPStopEventRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>SER-1d3</siri:MessageIdentifier>
                  <Location>
                      <PlaceRef>
                          <siri:StopPointRef>8592588</siri:StopPointRef>
                          <Name>
                              <Text>Schaffhausen, Wiesli</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Location>
                  <Params>
                      <LineFilter>
                          <Line>
                              <siri:LineRef>ojp:92003:B</siri:LineRef>
                              <siri:DirectionRef>R</siri:DirectionRef>
                          </Line>
                          <Exclude>false</Exclude>
                      </LineFilter>
                      <NumberOfResults>10</NumberOfResults>
                      <StopEventType>departure</StopEventType>
                  </Params>
              </OJPStopEventRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Body includes ojp:92003:B", function () {
      expect(res.getBody()?.toString()).to.include("ojp:92003:B");
  });
  
  test("Body doesn't include ojp:92007:D", function () {
      expect(res.getBody()?.toString()).to.not.include("ojp:92007:D");
  });
  
  test("Body includes DirectionRef R", function () {
      expect(res.getBody()?.toString()).to.include("<siri:DirectionRef>R</siri:DirectionRef>");
  });
  
  test("Body doesn't include DirectionRef H", function () {
      expect(res.getBody()?.toString()).to.not.include("<siri:DirectionRef>H</siri:DirectionRef>");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
