meta {
  name: SER-1g3_SPoR_IncludeOperatingDays-true
  type: http
  seq: 21
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPStopEventRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>SER-1g3</siri:MessageIdentifier>
                  <Location>
                      <PlaceRef>
                          <siri:StopPointRef>8530813</siri:StopPointRef>
                          <Name>
                              <Text>Zürich Kreuzplatz</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{Freitag12UhrVorFahrplanwechsel}}</DepArrTime>
                  </Location>
                  <Params>
                      <NumberOfResults>5</NumberOfResults>
                      <StopEventType>departure</StopEventType>
                      <IncludePreviousCalls>false</IncludePreviousCalls>
                      <IncludeOnwardCalls>false</IncludeOnwardCalls>
                      <IncludeOperatingDays>true</IncludeOperatingDays>
                      <IncludeRealtimeData>false</IncludeRealtimeData>
                  </Params>
              </OJPStopEventRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Body matches string", function () {
      expect(res.getBody()?.toString()).to.include("<Pattern>");
  });
  
}

settings {
  encodeUrl: true
}
