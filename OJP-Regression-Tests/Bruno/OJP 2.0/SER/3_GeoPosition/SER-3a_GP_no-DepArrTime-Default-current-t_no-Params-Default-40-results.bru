meta {
  name: SER-3a_GP_no-DepArrTime-Default-current-t_no-Params-Default-40-results
  type: http
  seq: 1
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPStopEventRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>SER-3a</siri:MessageIdentifier>
                  <Location>
                      <PlaceRef>
                          <GeoPosition>
                              <siri:Longitude>8.5545</siri:Longitude>
                              <siri:Latitude>47.365</siri:Latitude>
                          </GeoPosition>
                          <Name>
                              <Text>Zürich Kreuzplatz</Text>
                          </Name>
                      </PlaceRef>
                  </Location>
              </OJPStopEventRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Response contains >= 40 of <ThisCall>", function () {
      var searchString = "<ThisCall>";
      var responseBody = res.getBody()?.toString()
  
  
  
  ;
      var occurrencesCount = (responseBody.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrencesCount).to.be.at.least(40);
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
