meta {
  name: LIR-1d_SP_LocationName_GeoRestriction Circle
  type: http
  seq: 5
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Accept: application/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPLocationInformationRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>LIR-1d</siri:MessageIdentifier>
                  <InitialInput>
                      <GeoRestriction>
                          <Circle>
                              <Center>
                                  <siri:Longitude>8.55330</siri:Longitude>
                                  <siri:Latitude>47.37609</siri:Latitude>
                              </Center>
                              <Radius>1000</Radius>
                          </Circle>
                      </GeoRestriction>
                  </InitialInput>
                  <Restrictions>
                      <Type>stop</Type>
                      <NumberOfResults>10</NumberOfResults>
                  </Restrictions>
              </OJPLocationInformationRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Response contains specific StopPlaceRefs", function() {
      expect(res.getBody()?.toString()).to.include("8591412");
      expect(res.getBody()?.toString()).to.include("8591303");
      expect(res.getBody()?.toString()).to.include("8591123");
      expect(res.getBody()?.toString()).to.include("8591220");
      expect(res.getBody()?.toString()).to.include("8591192");
      expect(res.getBody()?.toString()).to.include("8591230");
      expect(res.getBody()?.toString()).to.include("8503500");
      expect(res.getBody()?.toString()).to.include("8591397");
      expect(res.getBody()?.toString()).to.include("8591078");
      expect(res.getBody()?.toString()).to.include("8591287");
  });
  
  test("PTMode muss enthalten sein", function () {
      expect(res.getBody()?.toString()).to.include("<PtMode>");
  });
  
  test("Check if XML body contains exactly 10 </StopPlaceRef> strings", function () {
      var searchString = "</StopPlaceRef>";
      var xmlResponse = res.getBody()?.toString();
      var occurrences = (xmlResponse.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrences).to.equal(10);
  });
  
  // Log DIDOK and StopName to console
  //var jsonData = xml2js(res.getBody());
  
  // Extract values of StopPlaceRef and StopPlaceName
  //var stopPlaces = jsonData['OJP']['OJPResponse']['siri:ServiceDelivery']['OJPLocationInformationDelivery']['PlaceResult'].map(function(placeResult) {
  //    return {
  //        StopPlaceRef: placeResult['Place']['StopPlace']['StopPlaceRef'],
  //        StopPlaceName: placeResult['Place']['StopPlace']['StopPlaceName']['Text']['_']
  //    };
  //});
  
  // Log the values to the console, each key-value pair on a separate line
  //stopPlaces.forEach(function(stopPlace) {
  //    console.log(+ stopPlace.StopPlaceRef, stopPlace.StopPlaceName);
  //});
}

settings {
  encodeUrl: true
  timeout: 0
}
