meta {
  name: LIR-1e_StopPointRef
  type: http
  seq: 7
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Accept: application/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
  	<OJPRequest>
  		<siri:ServiceRequest>
  			<siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
  			<siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
  			<OJPLocationInformationRequest>
  				<siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
  				<siri:MessageIdentifier>LIR-1e</siri:MessageIdentifier>
  				<PlaceRef>
  					<siri:StopPointRef>8530813</siri:StopPointRef>
  				</PlaceRef>
  				<Restrictions>
  					<Type>stop</Type>
  					<NumberOfResults>10</NumberOfResults>
  				</Restrictions>
  			</OJPLocationInformationRequest>
  		</siri:ServiceRequest>
  	</OJPRequest>
  </OJP>
  
}

script:post-response {
  test("Response contains </PlaceResult>", function() {
      expect(res.getBody()?.toString()).to.include("</PlaceResult>");
  
  });
  
  test("Response contains Zürich", function() {
      expect(res.getBody()?.toString()).to.include("Zürich");
  
  });
  
  test("PTMode muss enthalten sein", function () {
      expect(res.getBody()?.toString()).to.include("<PtMode>");
  });
}

settings {
  encodeUrl: true
}
