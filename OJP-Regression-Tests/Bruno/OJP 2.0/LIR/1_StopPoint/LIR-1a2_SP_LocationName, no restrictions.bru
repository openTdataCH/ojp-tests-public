meta {
  name: LIR-1a2_SP_LocationName, no restrictions
  type: http
  seq: 2
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Accept: application/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPLocationInformationRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>LIR-1a2</siri:MessageIdentifier>
                  <InitialInput>
                      <Name>Bern</Name>
                  </InitialInput>
              </OJPLocationInformationRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Contains no error", function () {
      expect(res.getBody()?.toString()).to.not.include("Object reference not set to an instance of an object");
  });
}

settings {
  encodeUrl: true
}
