meta {
  name: LIR-3a_POI_LocationName
  type: http
  seq: 1
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Accept: application/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPLocationInformationRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>LIR-3a</siri:MessageIdentifier>
                  <InitialInput>
                      <Name>hai</Name>
                  </InitialInput>
                  <Restrictions>
                      <Type>poi</Type>
                      <NumberOfResults>10</NumberOfResults>
                  </Restrictions>
              </OJPLocationInformationRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Response contains specific POI", function() {
      expect(res.getBody()?.toString()).to.include("Hair (Worb)");
  });
  
  test("Response contains maincategory service and hairdresser", function () {
      expect(res.getBody()?.toString()).to.include("service");
      expect(res.getBody()?.toString()).to.include("hairdresser");
  });
  
  test("Response contains >= 10 of </PointOfInterest>", function () {
      var searchString = "</PointOfInterest>";
      var responseBody = res.getBody()?.toString();
      var occurrencesCount = (responseBody.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrencesCount).to.be.at.least(10);
  });
  
}

settings {
  encodeUrl: true
}
