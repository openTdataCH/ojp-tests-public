meta {
  name: TR-1j2_OperatorFilter-Exclude-true
  type: http
  seq: 25
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-1j2</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <siri:StopPointRef>8592509</siri:StopPointRef>
                          <Name>
                              <Text>Neuhausen, Rheinstrasse</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <siri:StopPointRef>8503495</siri:StopPointRef>
                          <Name>
                              <Text>Schaffhausen, Bahnhof</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                      <OperatorFilter>
                          <Exclude>true</Exclude>
                          <OperatorRef>ojp:351</OperatorRef>
                      </OperatorFilter>
                      <NumberOfResults>5</NumberOfResults>
                      <IncludeIntermediateStops>false</IncludeIntermediateStops>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Kein OperatorRef 351 vorhanden", function () {
      expect(res.getBody()?.toString()).to.not.include("351</siri:OperatorRef>");
      expect(res.getBody()?.toString()).to.include("836</siri:OperatorRef>");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
