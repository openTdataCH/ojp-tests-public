meta {
  name: TR-1a5_no DepArrTime Now check for duplicate Trips and Distance
  type: http
  seq: 5
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-1a1NOW</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <StopPlaceRef>8572352</StopPlaceRef>
                          <Name>
                              <Text>Olten</Text>
                          </Name>
                      </PlaceRef>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <StopPlaceRef>8505000</StopPlaceRef>
                          <Name>
                              <Text>Luzern</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                      <NumberOfResults>10</NumberOfResults>
                      <IncludeTrackSections>true</IncludeTrackSections>
                      <IncludeLegProjection>true</IncludeLegProjection>
                      <IncludeTurnDescription>true</IncludeTurnDescription>
                      <IncludeIntermediateStops>true</IncludeIntermediateStops>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Contains <Distance>5583x", function () {
      expect(res.getBody()?.toString()).to.include("<Distance>5");
  });
  
  test("Contains <Length>27x", function () {
      expect(res.getBody()?.toString()).to.include("<Length>1");
  });
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
