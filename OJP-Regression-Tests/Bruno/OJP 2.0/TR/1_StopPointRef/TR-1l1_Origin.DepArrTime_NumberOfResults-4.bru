meta {
  name: TR-1l1_Origin.DepArrTime_NumberOfResults-4
  type: http
  seq: 29
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-1l1</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <siri:StopPointRef>8507000</siri:StopPointRef>
                          <Name>
                              <Text>Bern</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <siri:StopPointRef>8503424</siri:StopPointRef>
                          <Name>
                              <Text>Schaffhausen</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                      <NumberOfResults>4</NumberOfResults>
                      <IncludeIntermediateStops>false</IncludeIntermediateStops>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Response contains = 4 of </TripResult>", function () {
      var searchString = "</TripResult>";
      var responseBody = res.getBody()?.toString();
      var occurrencesCount = (responseBody.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrencesCount).equal(4);
  });
  
  test("Abfahrt nach 11:00 Uhr UTC", function () {
      expect(res.getBody()?.toString()).to.include("StartTime>" + bru.getCollectionVar
  ('friday_timetable_change') + "T11:02:00");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
