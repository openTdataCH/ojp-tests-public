meta {
  name: TR-1a3_no DepArrTime-Default-Origin-current-time_no-Params-Default-NumberOfResults-3
  type: http
  seq: 3
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-1a3</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <siri:StopPointRef>8507000</siri:StopPointRef>
                          <Name>
                              <Text>Bern</Text>
                          </Name>
                      </PlaceRef>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <siri:StopPointRef>8503424</siri:StopPointRef>
                          <Name>
                              <Text>Schaffhausen</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                      <NumberOfResults>3</NumberOfResults>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  // Generiere das aktuelle Datum im Format "YYYY-MM-DD"
  let currentDate = new Date().toISOString().split('T')[0];
  let formattedDate = "TimetabledTime>" + currentDate;
  
  // Überprüfe, ob das heutige Datum im Format "YYYY-MM-DD" im String "TimetabledTime>YYYY-MM-DD" vorkommt
  test('Überprüfe das heutige Datum im Format "YYYY-MM-DD"', function() {
      expect(res.getBody()?.toString()).to.include(formattedDate);
  });
  
  test("Response contains >= 3 of <TripResult>", function () {
      var searchString = "<TripResult>";
      var responseBody = res.getBody()?.toString();
      var occurrencesCount = (responseBody.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrencesCount).to.be.at.least(3);
  });
  
  test("Conains Belegungsdaten", function () {
      expect(res.getBody()?.toString()).to.include("<siri:ExpectedDepartureOccupancy>");
      expect(res.getBody()?.toString()).to.include("<siri:FareClass>firstClass</siri:FareClass>");
      expect(res.getBody()?.toString()).to.include("<siri:FareClass>secondClass </siri:FareClass>");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
