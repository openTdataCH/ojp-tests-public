meta {
  name: TR-3b1 korrekte StartTime
  type: http
  seq: 7
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="utf-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:schemaLocation="http://www.vdv.de/ojp" version="2.0">
    <OJPRequest>
      <siri:ServiceRequest>
        <siri:ServiceRequestContext>
          <siri:Language>de</siri:Language>
        </siri:ServiceRequestContext>
        <siri:RequestTimestamp>2024-09-17T10:52:58.171Z</siri:RequestTimestamp>
        <siri:RequestorRef>OJP_JS_SDK_v0.11.1</siri:RequestorRef>
        <OJPTripRequest>
          <siri:RequestTimestamp>2024-09-17T10:52:58.171Z</siri:RequestTimestamp>
          <siri:MessageIdentifier>TR-3b1</siri:MessageIdentifier>
          <Origin>
            <PlaceRef>
              <GeoPosition>
                <siri:Longitude>8.574967</siri:Longitude>
                <siri:Latitude>47.446226</siri:Latitude>
              </GeoPosition>
              <Name>
                <Text>47.446226,8.574967</Text>
              </Name>
            </PlaceRef>
            <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
          </Origin>
          <Destination>
            <PlaceRef>
              <StopPlaceRef>8507000</StopPlaceRef>
              <Name>
                <Text>Bern</Text>
              </Name>
            </PlaceRef>
          </Destination>
          <Via>
            <ViaPoint>
              <StopPlaceRef>8588739</StopPlaceRef>
              <Name>
                <Text>Kloten, Lägernstrasse</Text>
              </Name>
            </ViaPoint>
            <DwellTime>PT0M</DwellTime>
          </Via>
          <Params>
            <IncludeAllRestrictedLines>true</IncludeAllRestrictedLines>
            <NumberOfResults>1</NumberOfResults>
            <IncludeTrackSections>true</IncludeTrackSections>
            <IncludeLegProjection>true</IncludeLegProjection>
            <IncludeTurnDescription>true</IncludeTurnDescription>
            <IncludeIntermediateStops>true</IncludeIntermediateStops>
            <UseRealtimeData>none</UseRealtimeData>
          </Params>
        </OJPTripRequest>
      </siri:ServiceRequest>
    </OJPRequest>
  </OJP>
}

script:post-response {
  test("Response contains >=5 of TripResult", function () {
      var searchString = "</TripResult>";
      var responseBody = res.getBody()?.toString();
      var occurrencesCount = (responseBody.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrencesCount).to.be.at.least(1);
  });
  
  test("Body <StartTime> korrekt", function () {
      expect(res.getBody()?.toString()).to.include("<StartTime>2026-12-11T11:");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
