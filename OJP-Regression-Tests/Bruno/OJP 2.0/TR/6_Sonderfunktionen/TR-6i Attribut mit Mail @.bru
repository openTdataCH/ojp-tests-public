meta {
  name: TR-6i Attribut mit Mail @
  type: http
  seq: 12
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="utf-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:schemaLocation="http://www.vdv.de/ojp" version="2.0">
    <OJPRequest>
      <siri:ServiceRequest>
        <siri:ServiceRequestContext>
          <siri:Language>de</siri:Language>
        </siri:ServiceRequestContext>
        <siri:RequestTimestamp>2025-01-13T16:08:25.479Z</siri:RequestTimestamp>
        <siri:RequestorRef>OJP_JS_SDK_v0.15.1</siri:RequestorRef>
        <OJPTripRequest>
          <siri:RequestTimestamp>2025-01-13T16:08:25.479Z</siri:RequestTimestamp>
          <Origin>
            <PlaceRef>
              <StopPlaceRef>8507290</StopPlaceRef>
              <Name>
                <Text>Zweisimmen (Zweisimmen)</Text>
              </Name>
            </PlaceRef>
          <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
          </Origin>
          <Destination>
            <PlaceRef>
              <StopPlaceRef>8507492</StopPlaceRef>
              <Name>
                <Text>Interlaken Ost (Interlaken)</Text>
              </Name>
            </PlaceRef>
          </Destination>
          <Params>
            <IncludeAllRestrictedLines>true</IncludeAllRestrictedLines>
            <NumberOfResults>5</NumberOfResults>
            <IncludeTrackSections>true</IncludeTrackSections>
            <IncludeLegProjection>true</IncludeLegProjection>
            <IncludeTurnDescription>true</IncludeTurnDescription>
            <IncludeIntermediateStops>true</IncludeIntermediateStops>
            <UseRealtimeData>explanatory</UseRealtimeData>
          </Params>
        </OJPTripRequest>
      </siri:ServiceRequest>
    </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body contains Attribut mit @", function () {
      expect(res.getBody()?.toString()).to.include("@mob.ch");
  });
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
