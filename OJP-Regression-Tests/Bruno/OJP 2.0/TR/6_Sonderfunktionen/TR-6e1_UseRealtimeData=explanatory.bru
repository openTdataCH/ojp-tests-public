example {
  name: TR-6e_Trip Infeasible, da Zubringer verspätet
  
  request: {
    url: {{server2}}
    method: POST
    mode: xml
    headers: {
      Content-Type: text/xml
    }
  
    body:xml: {
      <?xml version="1.0" encoding="utf-8"?>
      <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:schemaLocation="http://www.vdv.de/ojp" version="2.0">
        <OJPRequest>
          <siri:ServiceRequest>
            <siri:RequestTimestamp>2024-07-24T07:05:08.058Z</siri:RequestTimestamp>
            <siri:RequestorRef>OJP_JS_SDK_v0.9.35</siri:RequestorRef>
            <OJPTripRequest>
              <siri:RequestTimestamp>2024-07-24T07:05:08.058Z</siri:RequestTimestamp>
              <Origin>
                <PlaceRef>
                  <StopPlaceRef>8014459</StopPlaceRef>
                  <Name>
                    <Text>Wyhlen</Text>
                  </Name>
