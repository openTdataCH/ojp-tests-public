meta {
  name: TR-9d DwellTime 120min Departure
  type: http
  seq: 5
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-1e2</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <siri:StopPointRef>8503000</siri:StopPointRef>
                          <Name>
                              <Text>Zürich HB</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <siri:StopPointRef>8503424</siri:StopPointRef>
                          <Name>
                              <Text>Schaffhausen</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Via>
                      <ViaPoint>
                          <siri:StopPointRef>8506000</siri:StopPointRef>
                          <Name>
                              <Text>Winterthur</Text>
                          </Name>
                      </ViaPoint>
                      <DwellTime>PT120M</DwellTime>
                  </Via>
                  <Params>
                      <NumberOfResultsBefore>3</NumberOfResultsBefore>
                      <IncludeIntermediateStops>true</IncludeIntermediateStops>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body matches string", function () {
      expect(res.getBody()?.toString()).to.include("Winterthur");
  });
  
  test("Body matches string", function () {
      expect(res.getBody()?.toString()).to.include("TimetabledTime>" + bru.getCollectionVar
  ('friday_timetable_change') + "T11");
  });
  
  test("Body matches string", function () {
      expect(res.getBody()?.toString()).to.include("TimetabledTime>" + bru.getCollectionVar
  ('friday_timetable_change') + "T13");
  });
  
  // Logs the entire response body as a raw text string
  console.log(res.getBody()?.toString());
}

settings {
  encodeUrl: true
  timeout: 0
}
