meta {
  name: TR-9a1 Via.StopPlaceRef DwellTime=0 Identische Fahrten
  type: http
  seq: 1
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-1a1NOW</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <GeoPosition>
                              <siri:Longitude>8.574967</siri:Longitude>
                              <siri:Latitude>47.446226</siri:Latitude>
                          </GeoPosition>
                          <Name>
                              <Text>47.446226,8.574967</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <StopPlaceRef>8507000</StopPlaceRef>
                          <Name>
                              <Text>Bern</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Via>
                      <ViaPoint>
                          <StopPlaceRef>8588739</StopPlaceRef>
                          <Name>
                              <Text>Kloten, Lägernstrasse</Text>
                          </Name>
                      </ViaPoint>
                      <DwellTime>PT0M</DwellTime>
                  </Via>
                  <Params>
                      <IncludeAllRestrictedLines>true</IncludeAllRestrictedLines>
                      <NumberOfResults>5</NumberOfResults>
                      <IncludeTrackSections>true</IncludeTrackSections>
                      <IncludeLegProjection>true</IncludeLegProjection>
                      <IncludeTurnDescription>true</IncludeTurnDescription>
                      <IncludeIntermediateStops>true</IncludeIntermediateStops>
                      <UseRealtimeData>explanatory</UseRealtimeData>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Response contains at least 5 of </TripResult>", function () {
      var searchString = "</TripResult>";
      var responseBody = res.getBody()?.toString();
      var occurrencesCount = (responseBody.match(new RegExp(searchString, "g")) || []).length;
      expect(occurrencesCount).to.be.at.least(5);
  });
  
  test("Body contains 8588739 Kloten Löwengasse", function () {
      expect(res.getBody()?.toString()).to.include("8588739");
  });
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
