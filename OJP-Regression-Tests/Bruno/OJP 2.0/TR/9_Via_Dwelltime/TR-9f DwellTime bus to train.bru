meta {
  name: TR-9f DwellTime bus to train
  type: http
  seq: 7
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-1e1</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <StopPlaceRef>8503000</StopPlaceRef>
                          <Name>
                              <Text>Zürich HB (Zürich)</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <GeoPosition>
                              <siri:Longitude>8.52066</siri:Longitude>
                              <siri:Latitude>47.36066</siri:Latitude>
                          </GeoPosition>
                          <Name>
                              <Text>47.360660,8.520660</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
  				<Via>
  					<ViaPoint>
  						<StopPlaceRef>8503010</StopPlaceRef>
  						<Name>
  							<Text>Zürich Enge</Text>
  						</Name>
  					</ViaPoint>
  					<DwellTime>PT2H</DwellTime>
  				</Via>
                  <Params>
                      <NumberOfResults>3</NumberOfResults>
                      <IncludeTrackSections>true</IncludeTrackSections>
                      <IncludeLegProjection>true</IncludeLegProjection>
                      <IncludeTurnDescription>true</IncludeTurnDescription>
                      <IncludeIntermediateStops>false</IncludeIntermediateStops>
                      <UseRealtimeData>none</UseRealtimeData>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Fahrt mit Tram oder Bus", function () {
      expect(res.getBody()?.toString()).to.include("Tram");
  });
  
  test("8503091 Zürich Giesshübel darf nicht vorhanden sein", function () {
      expect(res.getBody()?.toString()).to.not.include("8503091");
  });
  
  test("Abfahrt zweites Leg nach 14:00", function () {
      expect(res.getBody()?.toString()).to.include("TimetabledTime>" + bru.getCollectionVar('friday_timetable_change') + "T13");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
