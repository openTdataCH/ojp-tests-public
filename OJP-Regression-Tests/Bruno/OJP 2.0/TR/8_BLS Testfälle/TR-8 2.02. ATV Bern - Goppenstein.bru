meta {
  name: TR-8 2.02. ATV Bern - Goppenstein
  type: http
  seq: 22
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:schemaLocation="http://www.vdv.de/ojp" version="2.0">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-8-BLS Testfälle</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <StopPlaceRef>ch:1:sloid:7000:5:9</StopPlaceRef>
                          <Name>
                              <Text>Bern</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <StopPlaceRef>8580441</StopPlaceRef>
                          <Name>
                              <Text>Steg VS, Eggi (Steg VS)</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                      <IncludeAllRestrictedLines>true</IncludeAllRestrictedLines>
                      <NumberOfResults>0</NumberOfResults>
                      <IncludeTrackSections>true</IncludeTrackSections>
                      <IncludeLegProjection>true</IncludeLegProjection>
                      <IncludeTurnDescription>true</IncludeTurnDescription>
                      <ModeAndModeOfOperationFilter>
                          <siri:WaterSubmode>localCarFerry</siri:WaterSubmode>
                          <siri:RailSubmode>vehicleTunnelTransportRailService</siri:RailSubmode>
                      </ModeAndModeOfOperationFilter>
                      <UseRealtimeData>explanatory</UseRealtimeData>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body contains PtMode=rail", function () {
      expect(res.getBody()?.toString()).to.include("<PtMode>rail</PtMode>");
  });
  
  test("Body contains vehicleTunnelTransportRailService", function () {
      expect(res.getBody()?.toString()).to.include(">vehicleTunnelTransportRailService<");
  });
  
  test("No PT Trip (TimedLeg)", function () {
      expect(res.getBody()?.toString()).to.not.include("<TimedLeg>");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
