meta {
  name: TR-8 3.05 Schiff Thun - Interlaken Ost (See), West (See)
  type: http
  seq: 33
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:schemaLocation="http://www.vdv.de/ojp" version="2.0">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-8-BLS Testfälle</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <StopPlaceRef>8507150</StopPlaceRef>
                          <Name>
                              <Text>Thun (See) (Thun)</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{saturday_timetable_change}}T08:30:00.000Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <StopPlaceRef>8507158</StopPlaceRef>
                          <Name>
                              <Text>Neuhaus (Unterseen) (See)</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                      <NumberOfResults>5</NumberOfResults>
                      <IncludeTrackSections>true</IncludeTrackSections>
                      <IncludeLegProjection>true</IncludeLegProjection>
                      <IncludeTurnDescription>true</IncludeTurnDescription>
                      <IncludeIntermediateStops>true</IncludeIntermediateStops>
                      <UseRealtimeData>explanatory</UseRealtimeData>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Body contains <PtMode>water</PtMode>", function () {
      expect(res.getBody()?.toString()).to.include("<PtMode>water</PtMode>");
  });
  
  test("Body contains >Schiff</Text>", function () {
      expect(res.getBody()?.toString()).to.include(">Schiff</Text>");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
