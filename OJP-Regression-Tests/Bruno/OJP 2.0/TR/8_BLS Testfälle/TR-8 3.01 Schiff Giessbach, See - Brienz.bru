meta {
  name: TR-8 3.01 Schiff Giessbach, See - Brienz
  type: http
  seq: 30
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:schemaLocation="http://www.vdv.de/ojp" version="2.0">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-8-BLS Testfälle</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <StopPlaceRef>8508378</StopPlaceRef>
                          <Name>
                              <Text>Giessbach See (Brienz BE)</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>2026-12-06T11:00:00Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <StopPlaceRef>8508376</StopPlaceRef>
                          <Name>
                              <Text>Brienz (See) (Brienz BE)</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                      <NumberOfResults>5</NumberOfResults>
                      <IncludeTrackSections>true</IncludeTrackSections>
                      <IncludeLegProjection>true</IncludeLegProjection>
                      <IncludeTurnDescription>true</IncludeTurnDescription>
                      <IncludeIntermediateStops>true</IncludeIntermediateStops>
                      <UseRealtimeData>explanatory</UseRealtimeData>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:pre-request {
  // // HINWEIS: pm.variables.get() sucht im gesamten Scope (Global, Collection, Environment)
  const originalTime = bru.getCollectionVar
  ("friday_timetable_change");
  
  if (originalTime) {
      // 1. Erstellen eines Date-Objekts. (Behandelt ISO-Strings als UTC)
      const dateObject = new Date(originalTime);
  
      // 2. Fünf Tage vom Datum abziehen.
      dateObject.setDate(dateObject.getDate() - 5); 
  
      // 3. Manuelle Formatierung in das exakte OJP-Format YYYY-MM-DDTHH:mm:ssZ
      
      // Funktion zur Sicherstellung, dass Zahlen zweistellig sind (z.B. 01 statt 1)
      const pad = (num) => (num < 10 ? '0' + num : num);
  
      // Datumskomponenten (holen die UTC-Werte, um die Zeitzone Z beizubehalten)
      const year = dateObject.getUTCFullYear();
      const month = pad(dateObject.getUTCMonth() + 1); // getUTCMonth() ist 0-basiert
      const day = pad(dateObject.getUTCDate());
  
      // Zeitkomponenten
      const hour = pad(dateObject.getUTCHours());
      const minute = pad(dateObject.getUTCMinutes());
      const second = pad(dateObject.getUTCSeconds());
  
      // Den String zusammensetzen
      const timeMinus5Days = `${year}-${month}-${day}T${hour}:${minute}:${second}Z`;
  
      // 4. Den neuen Wert in der Originalvariable für DIESEN REQUEST speichern.
  //     //    pm.variables.set() setzt den Wert nur temporär für die Ausführung.
      bru.setVar("friday_timetable_change", timeMinus5Days);
      
      console.log(`Originalzeit: ${originalTime}`);
      console.log(`Neuer Zeitstempel (-5 Tage): ${timeMinus5Days}`);
  
  } else {
      // Die Variable ist nicht in Postman definiert oder kann nicht gefunden werden.
      console.error("KRITISCHER FEHLER: Variable 'friday_timetable_change' konnte nicht gefunden werden.");
  }
}

script:post-response {
  test("Body contains <PtMode>water</PtMode>", function () {
      expect(res.getBody()?.toString()
  
  
  
  ).to.include("<PtMode>water</PtMode>");
  });
  
  test("Body contains >Schiff</Text>", function () {
      expect(res.getBody()?.toString()
  
  
  
  ).to.include(">Schiff</Text>");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
