meta {
  name: TR-6k3 OptimisationMethod=minChanges Uzwil-Wil Echtzeit=full
  type: http
  seq: 3
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-6j</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <GeoPosition>
                              <siri:Longitude>9.13624</siri:Longitude>
                              <siri:Latitude>47.44702</siri:Latitude>
                          </GeoPosition>
                          <Name>
                              <Text>47.447020,9.136240</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <StopPlaceRef>8573602</StopPlaceRef>
                          <Name>
                              <Text>Wil SG, Bahnhof (Wil SG)</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                      <NumberOfResults>5</NumberOfResults>
                      <UseRealtimeData>full</UseRealtimeData>
                      <OptimisationMethod>minChanges</OptimisationMethod>
                      <IncludeTrackSections>true</IncludeTrackSections>
                      <IncludeLegProjection>true</IncludeLegProjection>
                      <IncludeTurnDescription>true</IncludeTurnDescription>
                      <IncludeIntermediateStops>true</IncludeIntermediateStops>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Darf nur Transfers = 0 ausgeben", function () {
      expect(res.getBody()?.toString()).to.include("<Transfers>0</Transfers>");
      expect(res.getBody()?.toString()).to.not.include("<Transfers>1</Transfers>");
      expect(res.getBody()?.toString()).to.not.include("<Transfers>2</Transfers>");
      expect(res.getBody()?.toString()).to.not.include("<Transfers>3</Transfers>");
      expect(res.getBody()?.toString()).to.not.include("<Transfers>4</Transfers>");
      expect(res.getBody()?.toString()).to.not.include("<Transfers>5</Transfers>");
      expect(res.getBody()?.toString()).to.not.include("<Transfers>6</Transfers>");
  });
  
  test("Anzahl von </TripResult> muss zwischen 5 und 10 liegen", function () {
      const responseBody = res.getBody()?.toString();
      const searchString = "</TripResult>";
      
      // Zähle die Vorkommen
      const count = (responseBody.split(searchString).length - 1);
      
      // Überprüfe, ob die Anzahl im Bereich [5, 8] liegt (inklusiv)
      expect(count).to.be.at.least(5, "Anzahl war kleiner als 5");
      expect(count).to.be.at.most(10, "Anzahl war größer als 10");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
