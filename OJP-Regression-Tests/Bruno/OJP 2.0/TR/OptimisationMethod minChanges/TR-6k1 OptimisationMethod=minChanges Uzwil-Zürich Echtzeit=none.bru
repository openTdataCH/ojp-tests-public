meta {
  name: TR-6k1 OptimisationMethod=minChanges Uzwil-Zürich Echtzeit=none
  type: http
  seq: 1
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>TR-6j</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <StopPlaceRef>8506208</StopPlaceRef>
                          <Name>
                              <Text>Uzwil</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{friday_timetable_change}}T11:00:00Z</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <StopPlaceRef>8503000</StopPlaceRef>
                          <Name>
                              <Text>Zürich HB</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                      <NumberOfResults>5</NumberOfResults>
                      <UseRealtimeData>none</UseRealtimeData>
                      <OptimisationMethod>minChanges</OptimisationMethod>
                      <IncludeTrackSections>true</IncludeTrackSections>
                      <IncludeLegProjection>false</IncludeLegProjection>
                      <IncludeTurnDescription>false</IncludeTurnDescription>
                      <IncludeIntermediateStops>false</IncludeIntermediateStops>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:post-response {
  test("Darf nur Transfers = 0 ausgeben", function () {
      expect(res.getBody()?.toString()).to.include("<Transfers>0</Transfers>");
      expect(res.getBody()?.toString()).to.not.include("<Transfers>1</Transfers>");
      expect(res.getBody()?.toString()).to.not.include("<Transfers>2</Transfers>");
      expect(res.getBody()?.toString()).to.not.include("<Transfers>3</Transfers>");
      expect(res.getBody()?.toString()).to.not.include("<Transfers>4</Transfers>");
      expect(res.getBody()?.toString()).to.not.include("<Transfers>5</Transfers>");
      expect(res.getBody()?.toString()).to.not.include("<Transfers>6</Transfers>");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
