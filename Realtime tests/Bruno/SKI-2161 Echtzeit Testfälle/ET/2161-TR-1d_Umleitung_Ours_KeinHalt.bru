meta {
  name: 2161-TR-1d_Umleitung_Ours_KeinHalt
  type: http
  seq: 4
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPTripRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>2161-TR-1d</siri:MessageIdentifier>
                  <Origin>
                      <PlaceRef>
                          <siri:StopPointRef>8592086</siri:StopPointRef>
                          <Name>
                              <Text>Lausanne, Ouchy-Olympique)</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{fixedTimestamp}}</DepArrTime>
                  </Origin>
                  <Destination>
                      <PlaceRef>
                          <siri:StopPointRef>8579237</siri:StopPointRef>
                          <Name>
                              <Text>Lausanne, Ours</Text>
                          </Name>
                      </PlaceRef>
                  </Destination>
                  <Params>
                    <ModeAndModeOfOperationFilter>
                      <Exclude>false</Exclude>
                      <PtMode>metro</PtMode>
                    </ModeAndModeOfOperationFilter>
                    <NumberOfResults>3</NumberOfResults>
                    <NumberOfResultsBefore>0</NumberOfResultsBefore>
                    <NumberOfResultsAfter>3</NumberOfResultsAfter>
                    <UseRealtimeData>full</UseRealtimeData>
                    <IncludeAllRestrictedLines>true</IncludeAllRestrictedLines>
                    <IncludeTrackSections>false</IncludeTrackSections>
                    <IncludeLegProjection>false</IncludeLegProjection>
                    <IncludeIntermediateStops>true</IncludeIntermediateStops>
                  </Params>
              </OJPTripRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
}

script:pre-request {
  // 1. Aktuelles Datum holen
  const now = new Date();
  
  // 2. Datum & Uhrzeit als formatierte Strings in der Ziel-Zeitzone und in UTC generieren
  // Wir nutzen "en-US", da dieses Format (MM/DD/YYYY) am sichersten von JS geparst wird.
  const bernString = now.toLocaleString("en-US", { timeZone: "Europe/Berlin" });
  const utcString = now.toLocaleString("en-US", { timeZone: "UTC" });
  
  // 3. Diese Strings zu temporären Date-Objekten parsen
  // (Diese nutzen intern die Server-Zeit, was aber für die Differenzberechnung völlig egal ist)
  const bernDate = new Date(bernString);
  const utcDate = new Date(utcString);
  
  // 4. Den dynamischen Offset in Stunden berechnen (1 für Winterzeit, 2 für Sommerzeit)
  const offsetHours = (bernDate - utcDate) / (1000 * 60 * 60);
  
  // 5. Gewünschte Zielzeit festlegen (hier: 17:00:00 Uhr)
  const targetHour = 17;
  const targetMinute = 0;
  
  // 6. Den finalen UTC-Zeitstempel berechnen
  // Wichtig: Wir nutzen Date.UTC() und ziehen Tag/Monat/Jahr aus dem 'bernDate'. 
  // So stimmt das Datum auch dann, wenn der CI-Server sich an einem anderen Tag befindet als Berlin.
  const finalDate = new Date(Date.UTC(
      bernDate.getFullYear(),
      bernDate.getMonth(),       // Hinweis: Monate starten in JavaScript bei 0!
      bernDate.getDate(),
      targetHour - offsetHours,    // Ziel-Uhrzeit abzüglich des Offsets = exakte UTC-Stunde
      targetMinute,
      0,                           // Sekunden
      0                            // Millisekunden
  ));
  
  // 7. In das ISO-Format umwandeln (gibt exakt den Wert in "Z" bzw. UTC aus)
  const fixedTimestamp = finalDate.toISOString();
  
  // 8. Als Postman-Variable speichern
  bru.setVar("fixedTimestamp", fixedTimestamp);
}

script:post-response {
  const text = res.getBody()?.toString();
  
  // Extrahiert alle kompletten <Trip>...</Trip> Blöcke in ein Array
  const tripBlocks = text.match(/<Trip>[\s\S]*?<\/Trip>/g) || [];
  
  test("Validierung: Keine Direkt-Verbindung um 17:47 Lokalzeit", function () {
      
      // Sucht, ob es einen Trip gibt, der beide Bedingungen erfüllt
      const conflict = tripBlocks.find(tripXml => {
          // Sucht die Startzeit und die Umstiege innerhalb dieses einen Trips
          const timeMatch = tripXml.match(/<StartTime>(.*?)<\/StartTime>/);
          const transferMatch = tripXml.match(/<Transfers>(.*?)<\/Transfers>/);
          
          if (timeMatch && transferMatch) {
              const utcTime = timeMatch[1];
              const transfers = transferMatch[1];
              
              // Umwandlung in Lokalzeit
              const localTime = new Date(utcTime).toLocaleTimeString("de-CH", { timeZone: "Europe/Zurich" });
              
              // Konflikt-Bedingung: Zeit beginnt mit 17:47 UND Transfers sind "0" (Direkt-Verbindung)
              return localTime.startsWith("17:47") && transfers === "0"; 
          }
          return false;
      });
  
      // Erwartung: Es darf kein Konflikt gefunden worden sein (muss undefined sein)
      expect(
          conflict, 
          `Fehlschlag: Eine Direkt-Verbindung (0 Umstiege) um 17:47 Lokalzeit wurde gefunden!`
      ).to.be.undefined;
  });
}

settings {
  encodeUrl: true
}
