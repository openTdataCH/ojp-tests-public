meta {
  name: 2161-SER-2d_Meldung_Wagonfabrik_Abfahrt
  type: http
  seq: 4
}

post {
  url: {{server2}}
  body: xml
  auth: bearer
}

headers {
  Content-Type: text/xml
}

auth:bearer {
  token: {{BearerToken}}
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <OJP xmlns="http://www.vdv.de/ojp" xmlns:siri="http://www.siri.org.uk/siri" version="2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.vdv.de/ojp OJP_changes_for_v1.1/OJP.xsd">
      <OJPRequest>
          <siri:ServiceRequest>
              <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
              <siri:RequestorRef>SKIPlusRegTest</siri:RequestorRef>
              <OJPStopEventRequest>
                  <siri:RequestTimestamp>{{isoTimestamp}}</siri:RequestTimestamp>
                  <siri:MessageIdentifier>2161-SER-2d</siri:MessageIdentifier>
                  <Location>
                      <PlaceRef>
                          <siri:StopPointRef>8590803</siri:StopPointRef>
                          <Name>
                              <Text>Schlieren, Wagonfabrik</Text>
                          </Name>
                      </PlaceRef>
                      <DepArrTime>{{isoTimestamp}}</DepArrTime>
                  </Location>
                  <Params>
                      <NumberOfResults>20</NumberOfResults>
                      <StopEventType>departure</StopEventType>
                  </Params>
              </OJPStopEventRequest>
          </siri:ServiceRequest>
      </OJPRequest>
  </OJP>
  
}

script:post-response {
  // 1. Response als XML lesen und in JSON umwandeln
  const xml2js = require('xml2js');
  let jsonBody;
  xml2js.parseString(res.getBody()?.toString(),{explicitArray: false}, (err, result)=>{
      jsonBody = result;
  });
  
  // Hilfsfunktion: Extrahiert Text aus verschiedenen XML-Knoten-Strukturen
  function getXmlText(node) {
      if (!node) return undefined;
      // Falls das Element Attribute hat (Struktur {_: "Text", $: {...}})
      if (typeof node === 'object' && node._) return node._;
      // Falls es ein direktes Objekt mit Text-Eigenschaft ist
      if (typeof node === 'object' && node.Text) {
          return typeof node.Text === 'object' ? node.Text._ : node.Text;
      }
      return node;
  }
  
  // Navigiere zum relevanten Delivery-Objekt
  const responseRoot = jsonBody.OJP?.OJPResponse || jsonBody.OJPResponse;
  const serviceDelivery = responseRoot["siri:ServiceDelivery"] || responseRoot.ServiceDelivery;
  const stopEventDelivery = serviceDelivery.OJPStopEventDelivery;
  
  let targetSituationNumber = null;
  
  test("Situation 'Unregelmässiger Betrieb Linie 2' finden", function () {
      let situationsNode = stopEventDelivery.StopEventResponseContext?.Situations?.PtSituation;
      let situations = Array.isArray(situationsNode) ? situationsNode : (situationsNode ? [situationsNode] : []);
      
      const targetSituation = situations.find(sit => {
          // Extrahiere Summary (Checkt beide XML Varianten)
          const summaryDirect = getXmlText(sit["siri:Summary"] || sit.Summary);
          
          // Suche in PublishingActions (Variante 2)
          let summaryNested = undefined;
          const pubActions = sit["siri:PublishingActions"]?.["siri:PublishingAction"] || sit.PublishingActions?.PublishingAction;
          if (pubActions) {
              const action = Array.isArray(pubActions) ? pubActions[0] : pubActions;
              summaryNested = getXmlText(action["siri:PassengerInformationAction"]?.["siri:TextualContent"]?.["siri:SummaryContent"]?.["siri:SummaryText"]);
          }
  
          const summaryText = summaryDirect || summaryNested;
          const endTime = sit["siri:ValidityPeriod"]?.["siri:EndTime"] || sit.ValidityPeriod?.EndTime;
          const scopeType = sit["siri:ScopeType"] || sit.ScopeType;
  
          return (summaryText && (summaryText.includes("Wagonsfabrik nicht bedient") || 
                  summaryText.includes("Wagonsfabrik ist nicht bedient"))) &&
                 endTime === "2500-12-31T00:00:00Z" &&
                 scopeType === "stopPoint";
      });
  
      expect(targetSituation, "Situation wurde in keiner der XML-Strukturen gefunden").to.not.be.undefined;
      
      targetSituationNumber = targetSituation["siri:SituationNumber"] || targetSituation.SituationNumber;
      console.log("Gefundene SituationNumber:", targetSituationNumber);
  });
  
  test("Alle Tram 5 StopEvents referenzieren die Situation", function () {
      expect(targetSituationNumber, "Keine SituationNumber für den Vergleich vorhanden").to.not.be.null;
  
      // In StopEventDelivery heißen die Ergebnisse StopEventResult
      let resultsNode = stopEventDelivery.StopEventResult;
      let stopEventResults = Array.isArray(resultsNode) ? resultsNode : (resultsNode ? [resultsNode] : []);
      
      let checkedCount = 0;
  
      stopEventResults.forEach((result, index) => {
          // Bei StopEvents liegt der Service direkt im StopEvent-Objekt
          const service = result.StopEvent?.Service;
          if (!service) return;
  
          // Produktkategorie und Servicename auslesen
          const catName = getXmlText(service.ProductCategory?.Name);
          const serviceName = getXmlText(service.PublishedServiceName);
  
          // Prüfung: Handelt es sich um das Tram Linie 2?
          if (catName === "Tram" && serviceName === "2") {
              checkedCount++;
              
              // Lese die Referenzen aus
              let refsNode = service.SituationFullRefs?.SituationFullRef;
              let refs = Array.isArray(refsNode) ? refsNode : (refsNode ? [refsNode] : []);
              
              // Schauen ob unsere gesuchte SituationNumber in der Liste der Referenzen auftaucht
              const hasTargetRef = refs.some(ref => {
                  const sitNum = ref["siri:SituationNumber"] || ref.SituationNumber;
                  return getXmlText(sitNum) === targetSituationNumber;
              });
              
              expect(
                  hasTargetRef, 
                  `StopEventResult Index ${index} (Tram 2) referenziert nicht die SituationNumber ${targetSituationNumber}`
              ).to.be.true;
          }
      });
  
      console.log(`Es wurden ${checkedCount} Tram 2 Abfahrten erfolgreich auf die Situation-Referenz geprüft.`);
      expect(checkedCount).to.be.greaterThan(0, "Es wurde keine Abfahrt mit Tram 2 im XML gefunden.");
  });
}

settings {
  encodeUrl: true
}
